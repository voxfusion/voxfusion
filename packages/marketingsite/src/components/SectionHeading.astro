---
/**
 * Numbered section rule ("01 FEATURES ────") and, under it, the section's
 * statement: a short claim with an optional quieter second sentence on the
 * same line. viewEvent reports the section to Umami once the statement
 * scrolls into view; it sits there rather than on the whole section because
 * a tall section never reaches Umami's 30% visibility threshold on phones.
 */
interface Props {
	number: string;
	tag: string;
	title?: string;
	description?: string;
	viewEvent?: string;
}

const { number, tag, title, description, viewEvent } = Astro.props;
---

<div class="section-header">
	<span class="section-number">{number}</span>
	<p class="section-tag">{tag}</p>
	<div class="section-line"></div>
</div>
{title && (
	<h2 class="statement" data-umami-view={viewEvent}>{title}{description && <span> {description}</span>}</h2>
)}

<style>
	.section-header { display: flex; gap: 16px; align-items: center; margin-bottom: 40px; }
	.section-number { font-size: 11px; color: #ff6b3d; }
	.section-tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #a3a3a3; }
	.section-line { flex: 1; height: 1px; background: #292929; }
	.statement { max-width: 860px; margin-bottom: 64px; font-size: clamp(26px, 2.8vw, 38px); line-height: 1.3; letter-spacing: -.05em; font-weight: 500; text-wrap: pretty; }
	.statement span { color: #7a7a7a; }
	@media (max-width: 800px) {
		.section-header { margin-bottom: 28px; }
		.statement { margin-bottom: 44px; }
	}
</style>

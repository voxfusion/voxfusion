---
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="footer">
	<div class="footer-row">
		<span class="footer-logo">[VOX<span>FUSION</span>]</span>
		<nav class="footer-links" aria-label="Footer">
			<a href="/download">{t("nav.download")}</a>
			<a href="https://github.com/voxfusion/voxfusion" target="_blank" rel="noopener noreferrer">{t("nav.github")}</a>
			<a href="/privacy">{t("footer.privacy")}</a>
			<a href="/terms">{t("footer.terms")}</a>
			<a href="/security">{t("footer.security")}</a>
		</nav>
	</div>
	<p class="footer-bottom">&copy; {new Date().getFullYear()} {t("footer.copyright")}</p>
</footer>

<style>
	.footer { max-width: 1280px; margin: 0 auto; padding: 0 40px 36px; font-family: var(--font-mono); }
	.footer a { text-decoration: none; color: inherit; }
	.footer-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; padding-block: 32px; border-top: 1px solid #222; }
	.footer-logo { font-size: 15px; font-weight: 700; letter-spacing: .1em; }
	.footer-logo span { color: #888; }
	.footer-links { display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 12px; color: #888; }
	.footer-links a { transition: color .2s; }
	.footer-links a:hover { color: #ff3e00; }
	.footer-bottom { font-size: 11px; color: #6f6f6f; }

	@media (max-width: 1050px) {
		.footer { padding-inline: 28px; }
	}
	@media (max-width: 540px) {
		.footer { padding: 0 20px 28px; }
		.footer-links { gap: 12px 22px; }
	}
</style>

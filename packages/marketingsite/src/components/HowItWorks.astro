---
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const barHeights = Array.from({ length: 22 }, (_, i) => 24 + Math.abs(Math.sin(i * 1.3)) * 76);
---

<ol class="steps">
	<li class="step" data-reveal>
		<div class="step-top"><span class="step-number">01</span><span class="step-tag">{t("how.step1.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<div class="keys"><span class="key"><b>⌃</b>control</span><span class="key-plus">+</span><span class="key"><b>⌥</b>option</span></div>
		</div>
		<h3>{t("how.step1.title")}</h3>
		<p>{t("how.step1.description")}</p>
	</li>
	<li class="step" data-reveal>
		<div class="step-top"><span class="step-number">02</span><span class="step-tag">{t("how.step2.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<div class="mini-wave">
				{barHeights.map((height, i) => (
					<span style={`--i: ${i}; --h: ${height}%`}></span>
				))}
			</div>
		</div>
		<h3>{t("how.step2.title")}</h3>
		<p>{t("how.step2.description")}</p>
	</li>
	<li class="step" data-reveal>
		<div class="step-top"><span class="step-number">03</span><span class="step-tag">{t("how.step3.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<div class="typed-field"><span class="typed-label">NOTES</span><span class="typed-text">Pick up oat milk on the way home.<i>▎</i></span></div>
		</div>
		<h3>{t("how.step3.title")}</h3>
		<p>{t("how.step3.description")}</p>
	</li>
</ol>

<style>
	.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; border: 1px solid #343434; background: #111; }
	.step { display: flex; flex-direction: column; min-width: 0; padding: 32px; }
	.step + .step { border-left: 1px solid #343434; }
	.step-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
	.step-number { font-size: 34px; line-height: 1; letter-spacing: -.05em; color: #ff4d19; }
	.step-tag { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: #8a8a8a; }
	.step-visual { display: flex; align-items: center; justify-content: center; height: 112px; margin-bottom: 26px; padding: 0 18px; border: 1px solid #2c2c2c; background: #0c0c0c; }
	.step h3 { margin-bottom: 10px; font-size: 20px; font-weight: 500; letter-spacing: -.04em; line-height: 1.35; }
	.step p { color: #a3a3a3; font-size: 13px; line-height: 1.85; }

	.keys { display: flex; align-items: center; gap: 12px; }
	.key { display: flex; flex-direction: column; gap: 8px; width: 76px; padding: 10px 12px; color: #d0b5a7; background: #211a16; border: 1px solid #634433; border-bottom-width: 4px; font-size: 10px; }
	.key b { font-size: 22px; line-height: 1; font-weight: 400; color: #ff754c; }
	.key-plus { color: #80685b; font-size: 16px; }

	.mini-wave { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: 230px; height: 56px; }
	.mini-wave span { width: 4px; height: var(--h); background: #ff4d19; animation: step-wave 1.8s ease-in-out infinite; animation-delay: calc(var(--i) * -.11s); }
	@keyframes step-wave { 0%, 100% { transform: scaleY(.4); opacity: .55; } 50% { transform: scaleY(1); opacity: 1; } }

	.typed-field { display: flex; flex-direction: column; gap: 10px; width: 100%; padding: 14px; border: 1px solid #343434; background: #191919; }
	.typed-label { font-size: 9px; letter-spacing: .08em; color: #8a8a8a; }
	.typed-text { color: #d5d5d5; font-size: 12px; line-height: 1.6; }
	.typed-text i { font-style: normal; color: #ff4d19; }

	@media (max-width: 1050px) {
		.step { padding: 26px 22px; }
		.key { width: 66px; padding-inline: 10px; }
	}
	@media (max-width: 800px) {
		.steps { grid-template-columns: 1fr; }
		.step + .step { border-left: 0; border-top: 1px solid #343434; }
	}
	@media (max-width: 540px) {
		.step { padding: 24px 20px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.mini-wave span { animation: none; }
	}
</style>

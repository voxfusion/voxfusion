---
import { defaultLang, type languages, useTranslations } from "../i18n/utils";
import KeyCombo from "./KeyCombo.astro";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const barHeights = Array.from({ length: 22 }, (_, i) => 24 + Math.abs(Math.sin(i * 1.3)) * 76);
---

<ol class="steps">
	<li class="step">
		<div class="step-top"><span class="step-number">01</span><span class="step-tag">{t("how.step1.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<KeyCombo keys={[{ symbol: "⌃", label: "control" }, { symbol: "⌥", label: "option" }]} />
		</div>
		<p>{t("how.step1.text")}</p>
	</li>
	<li class="step">
		<div class="step-top"><span class="step-number">02</span><span class="step-tag">{t("how.step2.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<div class="mini-wave">
				{barHeights.map((height) => (
					<span style={`--h: ${height}%`}></span>
				))}
			</div>
		</div>
		<p>{t("how.step2.text")}</p>
	</li>
	<li class="step">
		<div class="step-top"><span class="step-number">03</span><span class="step-tag">{t("how.step3.tag")}</span></div>
		<div class="step-visual" aria-hidden="true">
			<span class="typed-text tw-caret">{t("how.step3.sample")}<span class="tw-rest"></span></span>
		</div>
		<p>{t("how.step3.text")}</p>
	</li>
</ol>

<style>
	.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px; list-style: none; }
	.step { min-width: 0; padding-top: 20px; border-top: 1px solid #303030; }
	.step-top { display: flex; gap: 14px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
	.step-number { color: #ff6b3d; }
	.step-tag { color: #a3a3a3; }
	.step-visual { display: flex; align-items: center; height: 132px; }
	.step p { color: #a3a3a3; font-size: 14px; line-height: 1.7; }

	.mini-wave { display: flex; align-items: center; gap: 6px; height: 52px; }
	.mini-wave span { width: 3px; height: var(--h); background: #ff4d19; }
	.typed-text { color: #e2e2e2; font-size: 15px; line-height: 1.6; letter-spacing: -.02em; }

	@media (max-width: 1050px) {
		.steps { gap: 36px; }
		.mini-wave { gap: 4px; }
	}
	@media (max-width: 800px) {
		.steps { grid-template-columns: 1fr; gap: 0; }
		.step { padding-bottom: 28px; }
		.step-visual { height: 104px; }
	}
</style>

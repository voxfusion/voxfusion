---
/**
 * Data-flow diagram for the privacy section: voice goes microphone → speech
 * model → cursor inside the "Your Mac" boundary, and the link to a cloud
 * server is cut. Runs left to right on desktop, top to bottom on phones.
 */
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const nodes = (["mic", "model", "cursor"] as const).map((key) => ({
	title: t(`why.flow.${key}.title`),
	note: t(`why.flow.${key}.note`),
}));
const links = [t("why.flow.link.audio"), t("why.flow.link.text")];
---

<div class="flow" role="img" aria-label={t("why.flow.alt")}>
	<div class="flow-mac">
		<span class="flow-boundary">{t("why.flow.label")}</span>
		{nodes.map((node, i) => (
			<>
				{i > 0 && <span class="flow-link" style={`--i: ${i - 1}`}><em>{links[i - 1]}</em><i></i></span>}
				<div class="flow-node">
					<span class="flow-title">{node.title}</span>
					<span class="flow-note">{node.note}</span>
				</div>
			</>
		))}
	</div>
	<span class="flow-link is-cut"><b>✕</b></span>
	<div class="flow-node is-cloud">
		<span class="flow-title">{t("why.flow.cloud.title")}</span>
		<span class="flow-note">{t("why.flow.cloud.note")}</span>
	</div>
</div>

<style>
	.flow { display: flex; align-items: center; padding: 44px 48px 40px; border-bottom: 1px solid #3c2e25; background: #100e0c; }
	.flow-mac { position: relative; display: flex; flex: 1; align-items: center; min-width: 0; padding: 28px 24px; border: 1px solid #6b4635; }
	.flow-boundary { position: absolute; top: -8px; left: 16px; padding: 0 10px; background: #100e0c; color: #ff754c; font-size: 10px; letter-spacing: .14em; line-height: 16px; text-transform: uppercase; }
	.flow-node { display: flex; flex-direction: column; gap: 5px; flex-shrink: 0; padding: 12px 16px; border: 1px solid #4a3528; background: #1d1511; }
	.flow-title { color: #f3ddd2; font-size: 12px; letter-spacing: -.01em; white-space: nowrap; }
	.flow-note { color: #a08b7f; font-size: 10px; white-space: nowrap; }

	.flow-link { position: relative; flex: 1; min-width: 28px; height: 1px; background: #6b4635; }
	.flow-link::after { content: ""; position: absolute; top: -3px; right: 0; width: 6px; height: 6px; border: solid #6b4635; border-width: 1px 1px 0 0; transform: rotate(45deg); }
	.flow-link em { position: absolute; bottom: 9px; left: 50%; color: #8d7669; font-size: 9px; font-style: normal; letter-spacing: .12em; text-transform: uppercase; transform: translateX(-50%); }
	/* Pulse that travels each link in turn: voice in, text out. */
	.flow-link i { position: absolute; top: -2px; left: 0; width: 5px; height: 5px; background: var(--accent); box-shadow: 0 0 10px var(--accent); opacity: 0; animation: flow-pulse 3.2s linear infinite; animation-delay: calc(var(--i) * 1.1s); }
	@keyframes flow-pulse {
		0% { left: 0; opacity: 0; }
		4% { opacity: 1; }
		30% { opacity: 1; }
		34%, 100% { left: calc(100% - 5px); opacity: 0; }
	}

	.flow-link.is-cut { flex: 0 0 96px; height: 0; background: none; border-top: 1px dashed #5a4a41; }
	.flow-link.is-cut::after { content: none; }
	.flow-link b { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid #5a4a41; background: #100e0c; color: #ff754c; font-size: 10px; font-weight: 400; transform: translate(-50%, -50%); }
	.flow-node.is-cloud { border-style: dashed; border-color: #4a403a; background: none; }
	.is-cloud .flow-title { color: #8d7f77; text-decoration: line-through; text-decoration-color: #6b5a50; }
	.is-cloud .flow-note { color: #7d6f67; }

	@media (max-width: 1050px) {
		.flow { padding: 36px 32px 32px; }
		.flow-mac { padding-inline: 16px; }
		.flow-node { padding-inline: 12px; }
		.flow-link.is-cut { flex-basis: 56px; }
	}
	@media (max-width: 800px) {
		.flow { flex-direction: column; align-items: stretch; }
		.flow-mac { flex-direction: column; align-items: stretch; padding: 30px 20px 22px; }
		.flow-node { align-items: center; }
		.flow-link { flex: none; align-self: center; width: 1px; height: 30px; min-width: 0; }
		.flow-link::after { top: auto; right: -3px; bottom: 0; transform: rotate(135deg); }
		.flow-link em { bottom: auto; top: 50%; left: 14px; transform: translateY(-50%); }
		.flow-link i { top: 0; left: -2px; animation-name: flow-pulse-down; }
		.flow-link.is-cut { flex: none; width: 0; height: 44px; border-top: 0; border-left: 1px dashed #5a4a41; }
		@keyframes flow-pulse-down {
			0% { top: 0; opacity: 0; }
			4% { opacity: 1; }
			30% { opacity: 1; }
			34%, 100% { top: calc(100% - 5px); opacity: 0; }
		}
	}
	@media (max-width: 540px) {
		.flow { padding: 30px 22px 26px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.flow-link i { animation: none; }
	}
</style>

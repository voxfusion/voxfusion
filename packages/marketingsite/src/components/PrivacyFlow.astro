---
/**
 * Data-flow diagram for the privacy section: voice goes microphone → speech
 * model → cursor inside the "Your Mac" boundary, and the link to a cloud
 * server is cut. Runs left to right on desktop, top to bottom on phones.
 */
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const nodes = (["mic", "model", "cursor"] as const).map((key) => ({
	title: t(`why.flow.${key}.title`),
	note: t(`why.flow.${key}.note`),
}));
const links = [t("why.flow.link.audio"), t("why.flow.link.text")];
---

<div class="flow" role="img" aria-label={t("why.flow.alt")}>
	<div class="flow-mac">
		<span class="flow-boundary">{t("why.flow.label")}</span>
		{nodes.map((node, i) => (
			<>
				{i > 0 && <span class="flow-link"><em>{links[i - 1]}</em></span>}
				<div class="flow-node">
					<span class="flow-title">{node.title}</span>
					<span class="flow-note">{node.note}</span>
				</div>
			</>
		))}
	</div>
	<span class="flow-link is-cut"><b>✕</b></span>
	<div class="flow-node is-cloud">
		<span class="flow-title">{t("why.flow.cloud.title")}</span>
		<span class="flow-note">{t("why.flow.cloud.note")}</span>
	</div>
</div>

<style>
	.flow { display: flex; align-items: center; }
	.flow-mac { position: relative; display: flex; flex: 1; align-items: center; min-width: 0; padding: 32px 28px; border: 1px solid #3a3a3a; }
	.flow-boundary { position: absolute; top: -8px; left: 18px; padding: 0 10px; background: #0a0a0a; color: #ff6b3d; font-size: 10px; letter-spacing: .14em; line-height: 16px; text-transform: uppercase; }
	.flow-node { display: flex; flex-direction: column; gap: 5px; flex-shrink: 0; padding: 12px 16px; border: 1px solid #3a3a3a; background: #111; }
	.flow-title { color: #e6e6e6; font-size: 13px; letter-spacing: -.01em; white-space: nowrap; }
	.flow-note { color: #8a8a8a; font-size: 10px; white-space: nowrap; }

	.flow-link { position: relative; flex: 1; min-width: 28px; height: 1px; background: #4a4a4a; }
	.flow-link::after { content: ""; position: absolute; top: -3px; right: 0; width: 6px; height: 6px; border: solid #4a4a4a; border-width: 1px 1px 0 0; transform: rotate(45deg); }
	.flow-link em { position: absolute; bottom: 9px; left: 50%; color: #7a7a7a; font-size: 9px; font-style: normal; letter-spacing: .12em; text-transform: uppercase; transform: translateX(-50%); }

	.flow-link.is-cut { flex: 0 0 96px; height: 0; background: none; border-top: 1px dashed #4a4a4a; }
	.flow-link.is-cut::after { content: none; }
	.flow-link b { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid #4a4a4a; background: #0a0a0a; color: #ff6b3d; font-size: 10px; font-weight: 400; transform: translate(-50%, -50%); }
	.flow-node.is-cloud { border-style: dashed; background: none; }
	.is-cloud .flow-title { color: #8a8a8a; text-decoration: line-through; text-decoration-color: #5c5c5c; }
	.is-cloud .flow-note { color: #7a7a7a; }

	@media (max-width: 1050px) {
		.flow-mac { padding-inline: 16px; }
		.flow-node { padding-inline: 12px; }
		.flow-link.is-cut { flex-basis: 56px; }
	}
	@media (max-width: 800px) {
		.flow { flex-direction: column; align-items: stretch; }
		.flow-mac { flex-direction: column; align-items: stretch; padding: 30px 20px 22px; }
		.flow-node { align-items: center; }
		.flow-link { flex: none; align-self: center; width: 1px; height: 30px; min-width: 0; }
		.flow-link::after { top: auto; right: -3px; bottom: 0; transform: rotate(135deg); }
		.flow-link em { bottom: auto; top: 50%; left: 14px; transform: translateY(-50%); }
		.flow-link.is-cut { flex: none; width: 0; height: 44px; border-top: 0; border-left: 1px dashed #4a4a4a; }
	}
</style>

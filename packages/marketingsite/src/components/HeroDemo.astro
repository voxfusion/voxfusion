---
/**
 * Hero dictation demo. The first sample is rendered statically, so the
 * terminal reads correctly without JavaScript and for reduced-motion
 * visitors. The script then loops through the samples: listen, transcribe,
 * insert. Every sample must fit the two lines reserved for it on desktop
 * (three on phones), or the terminal changes height between samples.
 */
const samples = [
	{ app: "MAIL", text: "Hi Anna, the proposal looks great. Let's review it Thursday." },
	{ app: "SLACK", text: "Hey team, let's schedule a quick sync for tomorrow." },
	{ app: "CURSOR", text: "Add retry logic to the upload handler and write a test." },
];
const first = samples[0];
const barHeights = Array.from(
	{ length: 48 },
	(_, i) => 18 + Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.23)) * 82
);
---

<div class="hero-visual" role="img" aria-label="Demo: a spoken sentence is transcribed on the Mac and typed into the app in use">
	<div class="visual-caption"><span>VOICE → TEXT</span><span>WORKFLOW DEMO</span></div>
	<div class="terminal" data-demo data-samples={JSON.stringify(samples)}>
		<div class="terminal-header">
			<span class="terminal-title"><span class="terminal-mark">✳</span> voxfusion</span>
			<span class="local-status"><span></span> ON DEVICE</span>
		</div>
		<div class="terminal-body">
			<div class="input-label"><span>VOICE INPUT</span><span class="hotkey"><kbd>⌃</kbd> + <kbd>⌥</kbd></span></div>
			<p class="spoken-text" data-demo-spoken>“{first.text}”</p>
			<div class="waveform-raw">
				{barHeights.map((height, i) => (
					<div class="wave-bar" style={`--i: ${i}; --h: ${height}%`}></div>
				))}
			</div>
			<div class="processing-line"><span class="prompt">↳</span> <span data-demo-status>Transcribed locally</span> <span class="processing-engine">whisper.cpp</span></div>
			<div class="text-output">
				<div class="output-label"><span data-demo-app>{first.app}</span><span class="result" data-demo-result>[INSERTED]</span></div>
				<p><span data-demo-output>{first.text}</span><span class="cursor">▎</span></p>
			</div>
		</div>
		<div class="terminal-footer"><span>Audio stays on your Mac.</span><span>0 KB UPLOADED</span></div>
	</div>
</div>

<script>
	interface Sample {
		app: string;
		text: string;
	}

	const sleep = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

	async function playDemo(root: HTMLElement) {
		const samples: Sample[] = JSON.parse(root.dataset.samples ?? "[]");
		const spoken = root.querySelector<HTMLElement>("[data-demo-spoken]");
		const output = root.querySelector<HTMLElement>("[data-demo-output]");
		const app = root.querySelector<HTMLElement>("[data-demo-app]");
		const status = root.querySelector<HTMLElement>("[data-demo-status]");
		const result = root.querySelector<HTMLElement>("[data-demo-result]");
		if (!spoken || !output || !app || !status || !result || samples.length < 2) return;

		// The server-rendered first sample is already in its finished state.
		root.dataset.phase = "done";

		for (let index = 1; ; index = (index + 1) % samples.length) {
			await sleep(2600);
			while (document.hidden) await sleep(500);

			const sample = samples[index];
			const words = sample.text.split(" ");

			root.dataset.phase = "listening";
			app.textContent = sample.app;
			spoken.textContent = "“";
			output.textContent = "";
			status.textContent = "Listening…";
			result.textContent = "[WAITING]";
			await sleep(450);
			for (let count = 1; count <= words.length; count++) {
				const closing = count === words.length ? "”" : "";
				spoken.textContent = `“${words.slice(0, count).join(" ")}${closing}`;
				await sleep(170);
			}

			root.dataset.phase = "transcribing";
			status.textContent = "Transcribing on your Mac…";
			await sleep(800);

			status.textContent = "Transcribed locally";
			for (let count = 1; count <= sample.text.length; count++) {
				output.textContent = sample.text.slice(0, count);
				await sleep(16);
			}
			root.dataset.phase = "done";
			result.textContent = "[INSERTED]";
		}
	}

	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		for (const root of document.querySelectorAll<HTMLElement>("[data-demo]")) {
			playDemo(root);
		}
	}
</script>

<style>
	.hero-visual { position: relative; isolation: isolate; min-width: 0; }
	.hero-visual::before { content: ""; position: absolute; inset: -80px 0; z-index: -1; background: radial-gradient(closest-side, #ff4d191c, transparent); pointer-events: none; }
	.visual-caption { display: flex; justify-content: space-between; gap: 12px; color: #777; font-size: 9px; letter-spacing: .08em; padding-bottom: 14px; }
	.visual-caption span:first-child { color: #aaa; }
	.terminal { background: #111; border: 1px solid #3b3b3b; box-shadow: 10px 10px 0 #0a0a0a, 11px 11px 0 #272727; }
	.terminal-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid #303030; background: #181818; }
	.terminal-title { font-size: 13px; color: #ccc; display: flex; align-items: center; gap: 10px; }
	.terminal-mark { color: #ff4d19; font-size: 24px; line-height: 1; }
	.local-status { display: flex; align-items: center; gap: 8px; color: #a9b7a9; font-size: 9px; letter-spacing: .08em; }
	.local-status span { width: 5px; height: 5px; background: #96bd96; }
	.terminal-body { padding: 24px; }
	.input-label, .output-label { display: flex; justify-content: space-between; align-items: center; font-size: 9px; letter-spacing: .06em; color: #919191; }
	.hotkey { display: flex; gap: 5px; align-items: center; }
	.hotkey kbd { display: inline-flex; justify-content: center; align-items: center; width: 23px; height: 23px; border: 1px solid #3a3a3a; border-bottom-width: 2px; color: #ccc; font-family: inherit; font-size: 14px; transition: border-color .2s, color .2s, background .2s; }
	[data-phase="listening"] .hotkey kbd { border-color: #ff4d19; color: #ff7045; background: #1d1511; }
	.spoken-text { min-height: 3.4em; font-size: 17px; line-height: 1.7; margin-top: 18px; color: #ddd; letter-spacing: -.025em; }
	.waveform-raw { display: flex; align-items: center; justify-content: space-between; gap: 4px; height: 60px; margin: 22px 0; transition: transform .35s, opacity .35s; }
	[data-phase="transcribing"] .waveform-raw { transform: scaleY(.3); opacity: .5; }
	[data-phase="done"] .waveform-raw { transform: scaleY(.45); opacity: .6; }
	.wave-bar { width: 4px; height: var(--h); background: #ff4d19; opacity: .8; animation: wave 2s ease-in-out infinite; animation-delay: calc(var(--i) * -.08s); }
	@keyframes wave { 0%, 100% { transform: scaleY(.45); opacity: .55; } 50% { transform: scaleY(1); opacity: 1; } }
	.processing-line { display: flex; gap: 8px; align-items: center; padding: 14px 0; border-top: 1px solid #292929; color: #8c8c8c; font-size: 10px; }
	.prompt { color: #ff6b3d; }
	.processing-engine { margin-left: auto; color: #777; }
	.text-output { border: 1px solid #343434; padding: 16px; background: #191919; }
	.result { color: #9ebd9e; }
	[data-phase="listening"] .result, [data-phase="transcribing"] .result { color: #6f6f6f; }
	.text-output p { min-height: 3.6em; color: #d5d5d5; font-size: 13px; line-height: 1.8; margin-top: 12px; }
	.cursor { color: #ff4d19; animation: blink 1.1s steps(1) infinite; }
	@keyframes blink { 50% { opacity: 0; } }
	.terminal-footer { display: flex; justify-content: space-between; gap: 12px; padding: 13px 22px; border-top: 1px solid #303030; color: #888; font-size: 10px; }
	.terminal-footer span:last-child { color: #ff6b3d; font-size: 9px; letter-spacing: .08em; }
	@media (max-width: 1050px) {
		.terminal-body { padding: 20px; }
		.spoken-text { min-height: 5.1em; font-size: 15px; }
	}
	@media (max-width: 800px) {
		.hero-visual { max-width: 580px; width: 100%; }
		.spoken-text { min-height: 3.4em; }
	}
	@media (max-width: 540px) {
		.terminal-body { padding: 18px; }
		.terminal-header { padding: 16px 18px; }
		.spoken-text { min-height: 5.1em; }
		.text-output p { min-height: 5.4em; }
		.waveform-raw { gap: 3px; }
		.processing-line { font-size: 9px; gap: 6px; }
		.processing-engine { font-size: 8px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.wave-bar, .cursor { animation: none; }
	}
</style>

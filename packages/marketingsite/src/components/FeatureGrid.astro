---
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div class="features-grid">
	<article class="feature-card accent-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">01 / SHORTCUTS</span>
			<h3>{t("features.shortcuts.title")}</h3>
			<p>{t("features.shortcuts.description")}</p>
		</div>
		<div class="feature-preview shortcut-preview" aria-hidden="true">
			<div class="shortcut-mode">
				<span class="mode-label">HANDS-FREE</span>
				<div class="keys"><span class="key"><b>⌃</b>control</span><span class="key-plus">+</span><span class="key"><b>⌥</b>option</span></div>
				<span class="mode-hint">Tap to start, tap to stop</span>
			</div>
			<div class="shortcut-mode">
				<span class="mode-label">HOLD TO SPEAK</span>
				<div class="keys"><span class="key key-wide"><b>⌘</b>right command</span></div>
				<span class="mode-hint">Hold, talk, release</span>
			</div>
		</div>
	</article>

	<article class="feature-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">02 / ON DEVICE</span>
			<h3>{t("features.onDevice.title")}</h3>
			<p>{t("features.onDevice.description")}</p>
		</div>
		<div class="feature-preview model-preview" aria-hidden="true">
			<div class="preview-label">YOUR MAC <span class="preview-flag">[ OFFLINE ]</span></div>
			<div class="model-row is-active"><span class="model-dot"></span><span class="model-name">Whisper Large v3 Turbo</span><span class="model-meta">99 languages</span></div>
			<div class="model-row"><span class="model-dot"></span><span class="model-name">Parakeet TDT 0.6B v3</span><span class="model-meta">25 languages</span></div>
			<div class="preview-footer">Voice → Model → Text. All of it happens here.</div>
		</div>
	</article>

	<article class="feature-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">03 / VOCABULARY</span>
			<h3>{t("features.dictionary.title")}</h3>
			<p>{t("features.dictionary.description")}</p>
		</div>
		<div class="feature-preview dictionary-preview" aria-hidden="true">
			<div class="preview-tabs"><span class="is-active">DEFAULT</span><span>PER-APP</span><span>PER-SITE</span></div>
			<div class="dictionary-words"><span>VoxFusion</span><span>TypeScript</span><span>PostgreSQL</span><span>Kubernetes</span><span class="add-word">+ add</span></div>
			<div class="preview-footer"><span class="example-check">[✓]</span> Names. Terms. The words you use.</div>
		</div>
	</article>

	<article class="feature-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">04 / STYLES</span>
			<h3>{t("features.styles.title")}</h3>
			<p>{t("features.styles.description")}</p>
		</div>
		<div class="feature-preview rows-preview" aria-hidden="true">
			<div class="preview-label">STYLE PER APP <span>EXAMPLE</span></div>
			<div class="style-row"><span>Mail</span><span class="flow-arrow">→</span><span class="style-name">Professional</span></div>
			<div class="style-row"><span>Slack</span><span class="flow-arrow">→</span><span class="style-name">Casual</span></div>
			<div class="style-row"><span>Cursor</span><span class="flow-arrow">→</span><span class="style-name">Agents</span></div>
		</div>
	</article>

	<article class="feature-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">05 / FOCUS</span>
			<h3>{t("features.focus.title")}</h3>
			<p>{t("features.focus.description")}</p>
		</div>
		<div class="feature-preview volume-preview" aria-hidden="true">
			<div class="preview-label">SYSTEM AUDIO <span class="preview-flag">[ AUTO ]</span></div>
			<div class="volume-row"><span>Before</span><div class="volume-bar"><i style="width: 76%"></i></div></div>
			<div class="volume-row is-recording"><span>Recording</span><div class="volume-bar"><i style="width: 12%"></i></div></div>
			<div class="volume-row"><span>After</span><div class="volume-bar"><i style="width: 76%"></i></div></div>
		</div>
	</article>

	<article class="feature-card" data-reveal>
		<div class="feature-heading">
			<span class="feature-index">06 / HISTORY</span>
			<h3>{t("features.history.title")}</h3>
			<p>{t("features.history.description")}</p>
		</div>
		<div class="feature-preview rows-preview" aria-hidden="true">
			<div class="preview-label">RECENT TRANSCRIPTIONS <span>EXAMPLE</span></div>
			<div class="history-row"><span class="history-time">10:42</span><span>Let's schedule a quick sync for tomorrow.</span></div>
			<div class="history-row"><span class="history-time">09:18</span><span>The pull request is ready for review.</span></div>
		</div>
	</article>
</div>

<style>
	.features-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	.feature-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 36px;
		border: 1px solid #343434;
		background: #111;
		transition: border-color .2s, box-shadow .2s, opacity .5s, transform .5s;
	}

	.feature-card:hover { border-color: #686058; box-shadow: 6px 6px 0 #1b1b1b; }
	.accent-card { background: #15110f; border-color: #61402f; }
	.accent-card:hover { border-color: #8a5a41; box-shadow: 6px 6px 0 #241812; }
	.feature-index { display: block; margin-bottom: 24px; color: #ff754c; font-size: 11px; letter-spacing: .09em; }
	.feature-heading h3 { margin-bottom: 14px; font-size: 25px; font-weight: 500; letter-spacing: -.045em; line-height: 1.3; }
	.feature-heading p { margin-bottom: 32px; color: #aaa; font-size: 14px; line-height: 1.85; max-width: 480px; }
	.feature-preview { min-height: 174px; margin-top: auto; border: 1px solid #333; background: #0c0c0c; }
	.preview-label { display: flex; justify-content: space-between; gap: 12px; font-size: 10px; letter-spacing: .06em; color: #a0a0a0; }
	.preview-label > span { color: #777; }
	.preview-label > .preview-flag { color: #ff754c; }
	.preview-footer { display: flex; gap: 10px; font-size: 10px; color: #999; line-height: 1.7; }
	.flow-arrow { color: #756456; }

	.shortcut-preview { display: grid; grid-template-columns: 1.25fr 1fr; border-color: #3c2e25; background: #100e0c; }
	.shortcut-mode { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px; min-width: 0; padding: 20px 14px; }
	.shortcut-mode + .shortcut-mode { border-left: 1px solid #3c2e25; }
	.mode-label { color: #c9a996; font-size: 10px; letter-spacing: .08em; }
	.mode-hint { color: #a79183; font-size: 10px; text-align: center; }
	.keys { display: flex; align-items: center; justify-content: center; gap: 10px; }
	.key { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; width: 78px; padding: 10px 12px; color: #d0b5a7; background: #211a16; border: 1px solid #634433; border-bottom: 4px solid #634433; font-size: 10px; }
	.key b { font-size: 24px; line-height: 1; font-weight: 400; color: #ff754c; }
	.key-wide { width: 124px; }
	.key-plus { color: #80685b; font-size: 16px; }

	.model-preview { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 20px 24px; }
	.model-row { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border: 1px solid #2c2c2c; color: #9a9a9a; font-size: 12px; }
	.model-row.is-active { border-color: #67422f; background: #1d1511; color: #e2d5cd; }
	.model-dot { flex-shrink: 0; width: 7px; height: 7px; border: 1px solid #666; }
	.is-active .model-dot { border-color: #ff754c; background: #ff754c; }
	.model-name { min-width: 0; }
	.model-meta { margin-left: auto; flex-shrink: 0; color: #858585; font-size: 10px; }
	.is-active .model-meta { color: #ff754c; }
	.model-preview .preview-footer { justify-content: center; text-align: center; color: #888; }

	.dictionary-preview { padding: 20px 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
	.preview-tabs { display: flex; gap: 18px; border-bottom: 1px solid #2a2a2a; font-size: 10px; letter-spacing: .06em; color: #777; }
	.preview-tabs span { padding-bottom: 10px; margin-bottom: -1px; border-bottom: 1px solid transparent; }
	.preview-tabs .is-active { color: #d2d2d2; border-bottom-color: #ff754c; }
	.dictionary-words { display: flex; flex-wrap: wrap; gap: 8px; }
	.dictionary-words span { padding: 8px 10px; color: #d2d2d2; border: 1px solid #3c3c3c; border-bottom-color: #9c593b; font-size: 12px; }
	.dictionary-words .add-word { color: #777; border-style: dashed; border-color: #3c3c3c; }
	.example-check { color: #ff754c; }

	.rows-preview { padding: 22px 24px 6px; }
	.rows-preview .preview-label { margin-bottom: 14px; }
	.style-row { display: grid; grid-template-columns: 72px 20px 1fr; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid #2a2a2a; color: #bebebe; font-size: 12px; }
	.style-name { justify-self: start; padding: 4px 9px; border: 1px solid #4a3528; color: #ff9470; background: #1a1310; font-size: 11px; }
	.history-row { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 14px 0; border-top: 1px solid #2a2a2a; color: #bebebe; font-size: 11px; line-height: 1.8; }
	.history-time { color: #ff754c; font-size: 10px; }

	.volume-preview { display: flex; flex-direction: column; justify-content: space-between; gap: 12px; padding: 22px 24px; }
	.volume-row { display: grid; grid-template-columns: 82px 1fr; align-items: center; gap: 14px; color: #9a9a9a; font-size: 11px; }
	.volume-bar { height: 10px; background: repeating-linear-gradient(90deg, #262626 0 5px, transparent 5px 8px); }
	.volume-bar i { display: block; height: 100%; background: repeating-linear-gradient(90deg, #8c8c8c 0 5px, transparent 5px 8px); }
	.volume-row.is-recording { color: #ff754c; }
	.is-recording .volume-bar i { background: repeating-linear-gradient(90deg, #ff4d19 0 5px, transparent 5px 8px); }

	@media (max-width: 1050px) {
		.feature-card { padding: 28px; }
		.feature-heading h3 { font-size: 23px; }
		.model-preview, .dictionary-preview, .rows-preview, .volume-preview { padding-inline: 18px; }
		.key { width: 62px; padding-inline: 9px; font-size: 9px; }
		.key-wide { width: 112px; }
		.keys { gap: 7px; }
		.model-row { font-size: 11px; padding-inline: 10px; gap: 9px; }
	}

	@media (max-width: 800px) {
		.features-grid { grid-template-columns: 1fr; gap: 16px; }
		.feature-heading p { max-width: none; }
		.key { width: 78px; padding-inline: 12px; font-size: 10px; }
		.key-wide { width: 124px; }
		.keys { gap: 10px; }
	}

	@media (max-width: 540px) {
		.feature-card { padding: 24px 20px; }
		.feature-index { font-size: 10px; margin-bottom: 18px; }
		.feature-heading h3 { font-size: 23px; }
		.feature-heading p { font-size: 13px; margin-bottom: 24px; }
		.preview-label { font-size: 9px; }
		.model-preview, .dictionary-preview, .rows-preview, .volume-preview { padding-inline: 14px; }
		.shortcut-preview { grid-template-columns: 1fr; }
		.shortcut-mode + .shortcut-mode { border-left: 0; border-top: 1px solid #3c2e25; }
		.model-row { flex-wrap: wrap; gap: 4px 9px; }
		.model-meta { margin-left: 16px; width: 100%; }
		.history-row { gap: 8px; grid-template-columns: 36px 1fr; }
		.dictionary-words span { font-size: 11px; }
		.preview-tabs { gap: 14px; }
	}
</style>

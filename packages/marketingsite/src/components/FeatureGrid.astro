---
/**
 * Features: the app's own window (a real capture, not a drawing; its empty
 * lower edge is cropped away on wide screens), then six lines of text, each
 * a short claim with a quieter second sentence.
 */
import appWindowPhone from "../assets/app-history-phone.webp";
import appWindow from "../assets/app-history.webp";
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const features = (
	["onDevice", "languages", "dictionary", "styles", "focus", "history"] as const
).map((key, i) => ({
	index: `0${i + 1}`,
	label: t(`features.${key}.label`),
	lead: t(`features.${key}.lead`),
	rest: t(`features.${key}.rest`),
}));
---

<picture class="app-window">
	<source srcset={appWindowPhone.src} media="(max-width: 540px)" width={appWindowPhone.width / 3} height={appWindowPhone.height / 3} />
	<img src={appWindow.src} width={appWindow.width / 3} height={appWindow.height / 3} alt={t("features.window.alt")} loading="lazy" decoding="async" />
</picture>

<ul class="features">
	{features.map((feature) => (
		<li>
			<span class="feature-label"><b>{feature.index}</b>{feature.label}</span>
			<p><strong>{feature.lead}</strong> {feature.rest}</p>
		</li>
	))}
</ul>

<style>
	.app-window img { display: block; width: 100%; height: auto; aspect-ratio: 1024 / 650; object-fit: cover; object-position: top; border: 1px solid #3b3b3b; box-shadow: 10px 10px 0 #0a0a0a, 11px 11px 0 #272727; }

	.features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 56px; margin-top: 88px; list-style: none; }
	.features li { min-width: 0; padding-top: 20px; border-top: 1px solid #303030; }
	.feature-label { display: flex; gap: 14px; margin-bottom: 16px; color: #a3a3a3; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
	.feature-label b { color: #ff6b3d; font-weight: 400; }
	.features p { color: #8a8a8a; font-size: 15px; line-height: 1.7; letter-spacing: -.01em; }
	.features strong { color: #e6e6e6; font-weight: 500; }

	@media (max-width: 1050px) {
		.features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 36px; margin-top: 72px; }
	}
	@media (max-width: 540px) {
		.app-window img { aspect-ratio: auto; box-shadow: 6px 6px 0 #0a0a0a, 7px 7px 0 #272727; }
		.features { grid-template-columns: 1fr; gap: 28px; margin-top: 56px; }
		.features p { font-size: 14px; }
	}
</style>

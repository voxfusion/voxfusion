---
/**
 * The app's own window (a real capture, not a drawing; its empty lower edge
 * is cropped away on wide screens), then four plain facts under small labels.
 */
import appWindowPhone from "../assets/app-history-phone.webp";
import appWindow from "../assets/app-history.webp";
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const features = (["offline", "languages", "dictionary", "private"] as const).map((key) => ({
	label: t(`features.${key}.label`),
	text: t(`features.${key}.text`),
}));
---

<picture class="app-window">
	<source srcset={appWindowPhone.src} media="(max-width: 540px)" width={appWindowPhone.width / 3} height={appWindowPhone.height / 3} />
	<img src={appWindow.src} width={appWindow.width / 3} height={appWindow.height / 3} alt={t("features.window.alt")} loading="lazy" decoding="async" />
</picture>

<ul class="features" data-umami-view="view_features">
	{features.map((feature) => (
		<li>
			<h2>{feature.label}</h2>
			<p>{feature.text}</p>
		</li>
	))}
</ul>

<style>
	.app-window img { display: block; width: 100%; height: auto; aspect-ratio: 1024 / 650; object-fit: cover; object-position: top; border: 1px solid #2e2e2e; }

	.features { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px; margin-top: 64px; list-style: none; }
	.features h2 { margin-bottom: 12px; color: #8a8a8a; font-size: 11px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; }
	.features p { color: #c4c4c4; font-size: 14px; line-height: 1.7; }

	@media (max-width: 1050px) {
		.features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 36px; }
	}
	@media (max-width: 540px) {
		.app-window img { aspect-ratio: auto; }
		.features { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; }
	}
</style>

---
import { faqItems } from "../data/faq";
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const items = faqItems(t);
---

<div class="faq">
	<h2 class="faq-title" data-umami-view="view_faq">{t("faq.tag")}</h2>
	<div class="faq-list">
		{items.map((item) => (
			<details class="faq-item">
				<summary data-umami-event="faq_toggle" data-umami-event-question={item.id}>
					<h3>{item.question}</h3>
					<span class="faq-marker" aria-hidden="true"></span>
				</summary>
				<p>{item.answer}</p>
			</details>
		))}
	</div>
	<a class="faq-contact" href="https://github.com/voxfusion/voxfusion/issues" target="_blank" rel="noopener noreferrer" data-umami-event="faq_github_click">{t("faq.contact.github")} <span aria-hidden="true">→</span></a>
</div>

<style>
	.faq { max-width: 760px; }
	.faq-title { margin-bottom: 20px; color: #8a8a8a; font-size: 11px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; }

	.faq-list { border-top: 1px solid #262626; }
	.faq-item { border-bottom: 1px solid #262626; interpolate-size: allow-keywords; }
	.faq-item summary { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; }
	.faq-item summary::-webkit-details-marker { display: none; }
	.faq-item summary:hover h3, .faq-item[open] h3 { color: #fff; }
	.faq-item summary:focus-visible { outline: 2px solid #ff7045; outline-offset: 2px; }
	.faq-item h3 { font-size: 15px; font-weight: 400; line-height: 1.5; color: #d4d4d4; text-wrap: pretty; transition: color .2s; }
	.faq-marker { font-size: 15px; color: #6f6f6f; }
	.faq-marker::before { content: "+"; }
	.faq-item[open] .faq-marker::before { content: "−"; }
	.faq-item p { max-width: 640px; padding-bottom: 22px; color: #a8a8a8; font-size: 13px; line-height: 1.9; }
	/* Answers slide open where the browser can animate to height: auto. */
	.faq-item::details-content { block-size: 0; overflow: clip; opacity: 0; transition: block-size .3s var(--ease-out), opacity .3s, content-visibility .3s allow-discrete; }
	.faq-item[open]::details-content { block-size: auto; opacity: 1; }

	.faq-contact { display: inline-block; margin-top: 28px; padding-bottom: 3px; border-bottom: 1px solid #3a3a3a; color: #a8a8a8; font-size: 12px; transition: color .2s, border-color .2s; }
	.faq-contact:hover { color: #fff; border-color: #ff6b3d; }

	@media (max-width: 540px) {
		.faq-item h3 { font-size: 14px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content, .faq-item h3, .faq-contact { transition: none; }
	}
</style>

---
/**
 * Keycaps for a shortcut. `press` loops a press animation: "tap" for a
 * quick press-and-release, "hold" for a key that stays down a while.
 */
interface Key {
	symbol: string;
	label: string;
	wide?: boolean;
}

interface Props {
	keys: Key[];
	press?: "tap" | "hold";
	compact?: boolean;
}

const { keys, press, compact = false } = Astro.props;
---

<div class:list={["keys", { "is-compact": compact }]} data-press={press}>
	{keys.map((key, i) => (
		<>
			{i > 0 && <span class="key-plus">+</span>}
			<span class:list={["key", { "key-wide": key.wide }]}><b>{key.symbol}</b>{key.label}</span>
		</>
	))}
</div>

<style>
	.keys { display: flex; align-items: center; justify-content: center; gap: 10px; padding-bottom: 4px; }
	.key { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; width: 78px; padding: 10px 12px; color: #d0b5a7; background: #211a16; border: 1px solid #634433; box-shadow: 0 4px 0 #634433; font-size: 10px; white-space: nowrap; }
	.key b { font-size: 22px; line-height: 1; font-weight: 400; color: #ff754c; }
	.key-wide { width: 124px; }
	.key-plus { color: #80685b; font-size: 16px; }
	.is-compact { gap: 7px; }
	.is-compact .key { width: 64px; padding-inline: 9px; font-size: 9px; }
	.is-compact .key-wide { width: 112px; }

	[data-press="tap"] .key { animation: key-tap 3.6s var(--ease-out) infinite; }
	[data-press="hold"] .key { animation: key-hold 3.6s var(--ease-out) infinite; }
	@keyframes key-tap {
		0%, 8%, 22%, 100% { transform: none; box-shadow: 0 4px 0 #634433; background: #211a16; border-color: #634433; }
		12%, 18% { transform: translateY(3px); box-shadow: 0 1px 0 #ff4d19; background: #2d1d15; border-color: #ff4d19; }
	}
	@keyframes key-hold {
		0%, 46%, 96%, 100% { transform: none; box-shadow: 0 4px 0 #634433; background: #211a16; border-color: #634433; }
		52%, 90% { transform: translateY(3px); box-shadow: 0 1px 0 #ff4d19; background: #2d1d15; border-color: #ff4d19; }
	}

	@media (max-width: 1050px) {
		.keys { gap: 7px; }
		.key { width: 64px; padding-inline: 9px; font-size: 9px; }
		.key-wide { width: 112px; }
	}
	@media (max-width: 800px) {
		.keys, .is-compact { gap: 10px; }
		.key, .is-compact .key { width: 78px; padding-inline: 12px; font-size: 10px; }
		.key-wide, .is-compact .key-wide { width: 124px; }
	}
	@media (prefers-reduced-motion: reduce) {
		[data-press] .key { animation: none; }
	}
</style>

---
/** Keycaps for a shortcut. */
interface Key {
	symbol: string;
	label: string;
	wide?: boolean;
}

interface Props {
	keys: Key[];
}

const { keys } = Astro.props;
---

<div class="keys">
	{keys.map((key, i) => (
		<>
			{i > 0 && <span class="key-plus">+</span>}
			<span class:list={["key", { "key-wide": key.wide }]}><b>{key.symbol}</b>{key.label}</span>
		</>
	))}
</div>

<style>
	.keys { display: flex; align-items: center; justify-content: center; gap: 10px; padding-bottom: 4px; }
	.key { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; width: 78px; padding: 10px 12px; color: #d0b5a7; background: #211a16; border: 1px solid #634433; box-shadow: 0 4px 0 #634433; font-size: 10px; white-space: nowrap; }
	.key b { font-size: 22px; line-height: 1; font-weight: 400; color: #ff754c; }
	.key-wide { width: 124px; }
	.key-plus { color: #80685b; font-size: 16px; }

	@media (max-width: 1050px) {
		.keys { gap: 7px; }
		.key { width: 64px; padding-inline: 9px; font-size: 9px; }
		.key-wide { width: 112px; }
	}
	@media (max-width: 800px) {
		.keys { gap: 10px; }
		.key { width: 78px; padding-inline: 12px; font-size: 10px; }
		.key-wide { width: 124px; }
	}
</style>

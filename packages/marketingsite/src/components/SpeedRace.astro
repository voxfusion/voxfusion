---
/**
 * "Same sentence, two ways": the sentence is typed at ~40 wpm and spoken at
 * ~150 wpm, in real time, when the panel scrolls into view. Rendered
 * finished, so it reads correctly without JavaScript and for reduced-motion
 * visitors.
 */
import { defaultLang, type languages, useTranslations } from "../i18n/utils";

interface Props {
	lang?: keyof typeof languages;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const sentence = t("speed.sentence");
const rows = (["typing", "speaking"] as const).map((kind) => ({
	kind,
	label: t(`speed.${kind}.label`),
	rate: t(`speed.${kind}.rate`),
	time: t(`speed.${kind}.time`),
	// Ten words: 15 s at 40 wpm, 4 s at 150 wpm.
	ms: kind === "typing" ? 15000 : 4000,
}));
---

<div class="race" data-race data-reveal>
	<div class="race-head">
		<span>{t("speed.panel.title")}</span>
		<button type="button" class="race-replay" data-race-replay data-umami-event="speed_replay_click">
			<span aria-hidden="true">↻</span> {t("speed.replay")}
		</button>
	</div>
	{rows.map((row) => (
		<div class:list={["race-row", `is-${row.kind}`, "is-done"]} data-race-row data-ms={row.ms}>
			<div class="race-meta">
				<span class="race-label">
					{row.kind === "speaking" && <span class="race-eq" aria-hidden="true"><i></i><i></i><i></i></span>}
					{row.label}
				</span>
				<span class="race-rate">{row.rate}</span>
				<span class="race-time">{row.time}</span>
			</div>
			<p class="race-text tw-caret"><span data-race-text>{sentence}<span class="tw-rest"></span></span></p>
			<div class="race-bar" aria-hidden="true"><i></i></div>
		</div>
	))}
</div>

<script>
	import { prefersReducedMotion, renderTyped, typeText } from "../scripts/typewriter";

	function setupRace(race: HTMLElement) {
		const rows = [...race.querySelectorAll<HTMLElement>("[data-race-row]")].flatMap((row) => {
			const text = row.querySelector<HTMLElement>("[data-race-text]");
			return text ? [{ row, text, sentence: text.textContent ?? "", ms: Number(row.dataset.ms) }] : [];
		});
		let run = 0;

		function reset() {
			for (const { row, text, sentence } of rows) {
				row.classList.remove("is-done", "is-running");
				renderTyped(text, sentence, 0);
			}
		}

		function play() {
			const current = ++run;
			reset();
			for (const { row, text, sentence, ms } of rows) {
				row.style.setProperty("--race-ms", `${ms}ms`);
				// Commit the emptied bar before it starts filling again.
				void row.offsetWidth;
				row.classList.add("is-running");
				typeText(text, sentence, ms / sentence.length, () => current === run).then(() => {
					if (current !== run) return;
					row.classList.remove("is-running");
					row.classList.add("is-done");
				});
			}
		}

		// Start empty, then race once the panel is properly on screen.
		reset();
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				play();
			},
			{ threshold: 0.6 },
		);
		observer.observe(race);
		race.querySelector("[data-race-replay]")?.addEventListener("click", play);
	}

	if (!prefersReducedMotion() && "IntersectionObserver" in window) {
		for (const race of document.querySelectorAll<HTMLElement>("[data-race]")) {
			race.classList.add("is-live");
			setupRace(race);
		}
	}
</script>

<style>
	.race { border: 1px solid #343434; background: #111; box-shadow: 8px 8px 0 #0a0a0a, 9px 9px 0 #232323; }
	.race-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 22px; border-bottom: 1px solid #2c2c2c; background: #161616; color: #9a9a9a; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
	.race-replay { display: none; align-items: center; gap: 7px; padding: 4px 0; border: 0; background: none; color: #8a8a8a; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; transition: color .2s; }
	.race-replay:hover { color: var(--accent-soft); }
	.race-replay span { font-size: 13px; line-height: 1; }
	.is-live .race-replay { display: inline-flex; }

	.race-row { padding: 20px 22px 22px; }
	.race-row + .race-row { border-top: 1px solid #2c2c2c; }
	.race-row.is-speaking { background: var(--warm); }
	.race-meta { display: flex; align-items: baseline; gap: 14px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
	.race-label { display: flex; align-items: center; gap: 9px; color: #cfcfcf; }
	.is-speaking .race-label { color: var(--accent-soft); }
	.race-rate { color: #7d7d7d; }
	.race-time { margin-left: auto; color: #5c5c5c; font-size: 13px; letter-spacing: 0; text-transform: none; transition: color .3s; }
	.is-done .race-time { color: #d8d8d8; }
	.is-speaking.is-done .race-time { color: var(--accent-soft); }
	.race-eq { display: flex; align-items: center; gap: 2px; height: 10px; }
	.race-eq i { width: 2px; height: 4px; background: currentColor; }
	.is-running .race-eq i { height: 10px; animation: race-eq .5s ease-in-out infinite alternate; }
	.is-running .race-eq i:nth-child(2) { animation-delay: -.3s; }
	.is-running .race-eq i:nth-child(3) { animation-delay: -.15s; }
	@keyframes race-eq { from { transform: scaleY(.3); } to { transform: scaleY(1); } }

	.race-text { margin: 14px 0 16px; color: #e2e2e2; font-size: 14px; line-height: 1.7; letter-spacing: -.02em; }
	.is-done .tw-rest::before { display: none; }
	.race-bar { height: 8px; background: repeating-linear-gradient(90deg, #262626 0 5px, transparent 5px 8px); }
	.race-bar i { display: block; height: 100%; background: repeating-linear-gradient(90deg, #8c8c8c 0 5px, transparent 5px 8px); }
	.is-speaking .race-bar i { background: repeating-linear-gradient(90deg, var(--accent) 0 5px, transparent 5px 8px); }
	.is-live .race-bar i { clip-path: inset(0 100% 0 0); }
	.is-live .is-running .race-bar i { clip-path: inset(0); transition: clip-path var(--race-ms) linear; }
	.is-live .is-done .race-bar i { clip-path: inset(0); }

	@media (max-width: 540px) {
		.race-head, .race-row { padding-inline: 18px; }
		.race-text { font-size: 13px; }
		.race-meta { gap: 10px; }
	}
</style>

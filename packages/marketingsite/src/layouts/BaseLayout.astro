---
/**
 * Shared page shell for the whole site: head (Seo, fonts, favicons),
 * fixed nav with logo, footer, Umami analytics, and the
 * global base styles every page relies on.
 *
 * Nav variants:
 *   - showNavLinks renders the GitHub link.
 *   - ctaHref + ctaLabel render the text link on the right.
 *   - <slot name="nav-extra" /> renders inside <nav> after .nav-inner
 *     (used by the download page's mobile menu).
 *   - showFooter=false lets a page render its own footer (404).
 *
 * The font is self-hosted: the site makes no third-party font requests.
 */
import "@fontsource-variable/jetbrains-mono/wght.css";
import fontUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import Umami from "../components/Umami.astro";
import { defaultLang, getLocalizedPath, type languages, useTranslations } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	lang?: keyof typeof languages;
	noindex?: boolean;
	schema?: Record<string, unknown>;
	showNavLinks?: boolean;
	ctaHref?: string;
	ctaLabel?: string;
	bodyClass?: string;
	showFooter?: boolean;
}

const {
	title,
	description,
	lang = defaultLang,
	noindex = false,
	schema,
	showNavLinks = false,
	ctaHref,
	ctaLabel,
	bodyClass,
	showFooter = true,
} = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath("/", lang);
---

<!doctype html>
<html lang={lang}>
<head>
	<meta charset="UTF-8" />
	<Seo title={title} description={description} lang={lang} noindex={noindex} schema={schema} />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="theme-color" content="#0a0a0a" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
	<meta name="mailru-domain" content="a5ieqZ6Dkv267Psx" />
	<title>{title}</title>
</head>
<body class={bodyClass}>

	<nav class="nav">
		<div class="nav-inner">
			<a href={home} class="logo">
				<span class="logo-bracket">[</span>VOX<span class="logo-accent">FUSION</span><span class="logo-bracket">]</span>
			</a>
			{showNavLinks && (
				<a href="https://github.com/voxfusion/voxfusion" target="_blank" rel="noopener noreferrer" class="nav-link">{t("nav.github")}</a>
			)}
			{ctaHref && ctaLabel && <a href={ctaHref} class="nav-link nav-cta">{ctaLabel}</a>}
		</div>
		<slot name="nav-extra" />
	</nav>

	<slot />

	{showFooter && <Footer lang={lang} />}
	<Umami />
</body>
</html>

<style is:global>
	:root {
		--bg: #0a0a0a;
		--surface: #111;
		--surface-2: #181818;
		--inset: #0c0c0c;
		--line: #2a2a2a;
		--line-strong: #343434;
		--text: #e6e6e6;
		--text-2: #a8a8a8;
		--text-3: #858585;
		--accent: #ff4d19;
		--accent-hot: #ff3e00;
		--accent-soft: #ff7045;
		--accent-deep: #7a2409;
		--warm: #15110f;
		--warm-2: #1d1511;
		--warm-line: #493026;
		--ok: #96bd96;
		--ease-out: cubic-bezier(.2, .7, .2, 1);
		--font-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	html {
		font-family: var(--font-mono);
		background: #0a0a0a;
		color: #e0e0e0;
		scroll-behavior: smooth;
		scroll-padding-top: 40px;
		font-size: 15px;
		-webkit-font-smoothing: antialiased;
	}

	body {
		min-height: 100vh;
		position: relative;
	}

	h1, h2, h3 {
		text-wrap: balance;
	}

	/* Navigation */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: 1px solid #222;
		background: rgba(10, 10, 10, 0.92);
		backdrop-filter: blur(12px);
	}

	.nav-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 20px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #e0e0e0;
	}

	.logo-bracket {
		display: inline-block;
		color: #ff3e00;
		transition: transform .25s var(--ease-out);
	}

	.logo:hover .logo-bracket:first-child { transform: translateX(-3px); }
	.logo:hover .logo-bracket:last-child { transform: translateX(3px); }

	.logo-accent {
		color: #666;
	}

	.nav-inner .logo { margin-right: auto; }

	.nav-link {
		margin-left: 32px;
		font-size: 11px;
		color: #888;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		white-space: nowrap;
		transition: color 0.2s;
	}

	.nav-link:hover { color: #fff; }
	.nav-cta { color: #e0e0e0; }
	.nav-cta:hover { color: #ff4d19; }

	::selection { background: #ff4d19; color: #0a0a0a; }
	a:focus-visible, button:focus-visible { outline: 2px solid #ff7045; outline-offset: 5px; }

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.logo-bracket { transition: none; }
	}
	@media (max-width: 1050px) { .nav-inner { padding-inline: 28px; } }
	@media (max-width: 540px) { .nav-inner { padding: 18px 20px; } .logo { font-size: 13px; } .nav-link { margin-left: 20px; font-size: 10px; } }
</style>

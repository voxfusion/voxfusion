---
/**
 * Shared page shell for the whole site: head (Seo, fonts, favicons),
 * fixed nav with logo, grid overlay, footer, Umami analytics, and the
 * global base styles every page relies on.
 *
 * Nav variants:
 *   - showNavLinks renders the landing-section / GitHub link group.
 *   - ctaHref + ctaLabel render the bordered CTA on the right.
 *   - <slot name="nav-extra" /> renders inside <nav> after .nav-inner
 *     (used by the download page's mobile menu).
 *   - showFooter=false lets a page render its own footer (404).
 *
 * The font is self-hosted: the site makes no third-party font requests.
 */
import "@fontsource-variable/jetbrains-mono/wght.css";
import fontUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import Umami from "../components/Umami.astro";
import { defaultLang, getLocalizedPath, type languages, useTranslations } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	lang?: keyof typeof languages;
	noindex?: boolean;
	schema?: Record<string, unknown>;
	showNavLinks?: boolean;
	ctaHref?: string;
	ctaLabel?: string;
	bodyClass?: string;
	showFooter?: boolean;
}

const {
	title,
	description,
	lang = defaultLang,
	noindex = false,
	schema,
	showNavLinks = false,
	ctaHref,
	ctaLabel,
	bodyClass,
	showFooter = true,
} = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath("/", lang);
---

<!doctype html>
<html lang={lang}>
<head>
	<meta charset="UTF-8" />
	<Seo title={title} description={description} lang={lang} noindex={noindex} schema={schema} />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="theme-color" content="#0a0a0a" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
	<meta name="mailru-domain" content="a5ieqZ6Dkv267Psx" />
	<title>{title}</title>
</head>
<body class={bodyClass}>
	<div class="grid-overlay" aria-hidden="true"></div>

	<nav class="nav">
		<div class="nav-inner">
			<a href={home} class="logo">
				<span class="logo-bracket">[</span>VOX<span class="logo-accent">FUSION</span><span class="logo-bracket">]</span>
			</a>
			{showNavLinks && (
				<div class="nav-links">
					<a href={`${home}#features`} class="nav-link"><span class="link-index">01</span>{t("nav.features")}</a>
					<a href={`${home}#privacy`} class="nav-link"><span class="link-index">02</span>{t("nav.privacy")}</a>
					<a href={`${home}#faq`} class="nav-link"><span class="link-index">03</span>{t("nav.faq")}</a>
					<a href="https://github.com/voxfusion/voxfusion" target="_blank" rel="noopener noreferrer" class="nav-link"><span class="link-index">04</span>{t("nav.github")}</a>
				</div>
			)}
			{ctaHref && ctaLabel && <a href={ctaHref} class="nav-cta">{ctaLabel}</a>}
		</div>
		<slot name="nav-extra" />
	</nav>

	<slot />

	{showFooter && <Footer lang={lang} />}
	<Umami />
	<script is:inline>
		if ("IntersectionObserver" in window) {
			// Highlight the nav link of the section crossing the middle of the viewport.
			var navLinks = {};
			document.querySelectorAll(".nav-link[href*='#']").forEach(function (link) {
				navLinks[link.getAttribute("href").split("#")[1]] = link;
			});
			var sectionObserver = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						var link = navLinks[entry.target.id];
						if (link) link.classList.toggle("is-active", entry.isIntersecting);
					});
				},
				{ rootMargin: "-45% 0px -55% 0px" },
			);
			Object.keys(navLinks).forEach(function (id) {
				var section = document.getElementById(id);
				if (section) sectionObserver.observe(section);
			});
		}
	</script>
</body>
</html>

<style is:global>
	:root {
		--bg: #0a0a0a;
		--surface: #111;
		--surface-2: #181818;
		--inset: #0c0c0c;
		--line: #2a2a2a;
		--line-strong: #343434;
		--text: #e6e6e6;
		--text-2: #a8a8a8;
		--text-3: #858585;
		--accent: #ff4d19;
		--accent-hot: #ff3e00;
		--accent-soft: #ff7045;
		--accent-deep: #7a2409;
		--warm: #15110f;
		--warm-2: #1d1511;
		--warm-line: #493026;
		--ok: #96bd96;
		--ease-out: cubic-bezier(.2, .7, .2, 1);
		--font-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	html {
		font-family: var(--font-mono);
		background: #0a0a0a;
		color: #e0e0e0;
		scroll-behavior: smooth;
		scroll-padding-top: 40px;
		font-size: 15px;
		-webkit-font-smoothing: antialiased;
	}

	body {
		min-height: 100vh;
		position: relative;
	}

	h1, h2, h3 {
		text-wrap: balance;
	}

	.grid-overlay {
		position: fixed;
		inset: 0;
		background-image:
			linear-gradient(rgba(255,255,255,0.014) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,0.014) 1px, transparent 1px);
		background-size: 64px 64px;
		pointer-events: none;
		z-index: 0;
	}

	/* Navigation */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: 1px solid #222;
		background: rgba(10, 10, 10, 0.92);
		backdrop-filter: blur(12px);
	}

	.nav-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 20px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #e0e0e0;
	}

	.logo-bracket {
		display: inline-block;
		color: #ff3e00;
		transition: transform .25s var(--ease-out);
	}

	.logo:hover .logo-bracket:first-child { transform: translateX(-3px); }
	.logo:hover .logo-bracket:last-child { transform: translateX(3px); }

	.logo-accent {
		color: #666;
	}

	.nav-links {
		display: flex;
		gap: 32px;
	}

	.nav-link {
		position: relative;
		font-size: 11px;
		color: #888;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		white-space: nowrap;
		transition: color 0.2s;
	}

	.nav-link::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -8px;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform .3s var(--ease-out);
	}

	.nav-link:hover,
	.nav-link.is-active {
		color: #fff;
	}

	.nav-link.is-active::after {
		transform: scaleX(1);
	}

	.link-index {
		color: #ff3e00;
		margin-right: 8px;
	}

	.nav-cta {
		padding: 10px 16px;
		border: 1px solid #ff3e00;
		color: #ff3e00;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		white-space: nowrap;
		transition: all 0.2s;
	}

	.nav-cta:hover {
		background: #ff3e00;
		color: #000;
	}

	::selection { background: #ff4d19; color: #0a0a0a; }
	a:focus-visible, button:focus-visible { outline: 2px solid #ff7045; outline-offset: 5px; }

	/* Typewriter (scripts/typewriter.ts): the untyped remainder holds its space, and carries the caret. */
	.tw-rest { visibility: hidden; }
	.tw-caret .tw-rest::before { content: ""; position: absolute; width: 2px; height: 1.15em; margin: .22em 0 0 2px; background: var(--accent); visibility: visible; }

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.logo-bracket { transition: none; }
	}
	@media (max-width: 1050px) { .nav-inner { padding-inline: 28px; } .nav-links { gap: 20px; } }
	@media (max-width: 540px) { .nav-inner { padding: 18px 20px; } .logo { font-size: 13px; } .nav-cta { font-size: 10px; padding: 10px 12px; } }
	@media (max-width: 940px) {
		.nav-links {
			display: none;
		}
	}
</style>

---
import Faq from "../components/Faq.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import HeroDemo from "../components/HeroDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { defaultLang, getLocalizedPath, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { softwareApplicationSchema } from "../seo";

const lang = defaultLang;
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");
const schema = softwareApplicationSchema(description);
const downloadHref = getLocalizedPath("/download", lang);

const stats = (["local", "uploads", "languages", "price"] as const).map((key) => ({
	value: t(`hero.stat.${key}.value`),
	label: t(`hero.stat.${key}.label`),
}));
const tickerApps = [
	"Mail",
	"Slack",
	"Notes",
	"Messages",
	"Notion",
	"Chrome",
	"VS Code",
	"Cursor",
	"Terminal",
	"Linear",
	"Figma",
	"Safari",
];
const compareRows = (["audio", "offline", "account", "price", "source"] as const).map((key) => ({
	label: t(`why.compare.${key}.label`),
	cloud: t(`why.compare.${key}.cloud`),
	local: t(`why.compare.${key}.local`),
}));
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	schema={schema}
	showNavLinks
	ctaHref={downloadHref}
	ctaLabel={`${t("nav.download")} →`}
>
	<main id="main-content">
	<header class="hero">
		<div class="hero-grid">
			<div class="hero-content">
				<div class="hero-label">
					<span class="label-line" aria-hidden="true"></span>
					<span class="label-text">{t("hero.label")}</span>
				</div>
				<h1 class="hero-title">
					<span class="title-line">{t("hero.title.line1")}</span>
					<span class="title-line">{t("hero.title.line2")}</span>
					<span class="title-line title-accent">{t("hero.title.line3")}</span>
				</h1>
				<p class="hero-description">{t("hero.subtitle")}</p>
				<div class="hero-actions">
					<a href={downloadHref} class="btn-primary" data-umami-event="hero_download_click">
						<span class="btn-icon">↓</span>
						<span>{t("hero.cta.download")}</span>
					</a>
					<a href="https://github.com/voxfusion/voxfusion" target="_blank" rel="noopener noreferrer" class="btn-secondary" data-umami-event="hero_github_click">
						<svg class="btn-icon" viewBox="0 0 1024 1024" width="16" height="16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0" clip-rule="evenodd"/></svg>
						<span>{t("nav.github")}</span>
					</a>
				</div>
				<p class="hero-note"><span aria-hidden="true">[✓]</span> {t("hero.note.free")} <span class="note-divider">/</span> {t("hero.note.account")} <span class="note-divider">/</span> {t("hero.note.platform")}</p>
			</div>
			<HeroDemo />
		</div>
		<div class="hero-stats">
			{stats.map((stat) => (
				<div class="stat">
					<span class="stat-value">{stat.value}</span>
					<span class="stat-label">{stat.label}</span>
				</div>
			))}
		</div>
		<div class="ticker">
			<span class="ticker-label">{t("hero.ticker.label")}</span>
			<div class="ticker-window">
				<div class="ticker-track">
					{[false, true].map((isClone) => (
						<ul aria-hidden={isClone ? "true" : undefined}>
							{tickerApps.map((app) => <li>{app}</li>)}
						</ul>
					))}
				</div>
			</div>
		</div>
	</header>

	<section id="how" class="section">
		<SectionHeading number="01" tag={t("how.tag")} title={t("how.title")} description={t("how.description")} viewEvent="view_how" />
		<HowItWorks lang={lang} />
	</section>

	<section id="features" class="section">
		<SectionHeading number="02" tag={t("features.tag")} title={t("features.title")} description={t("features.description")} viewEvent="view_features" />
		<FeatureGrid lang={lang} />
	</section>

	<section id="privacy" class="section">
		<SectionHeading number="03" tag={t("why.section")} />
		<div class="highlight-block" data-reveal data-umami-view="view_privacy">
			<div class="highlight-copy">
				<p class="highlight-label">{t("why.tag")}</p>
				<h2 class="highlight-title">{t("why.title")}</h2>
				<p class="highlight-desc">{t("why.description")}</p>
				<ul class="highlight-list">
					<li><span class="check" aria-hidden="true">[✓]</span> {t("why.list1")}</li>
					<li><span class="check" aria-hidden="true">[✓]</span> {t("why.list2")}</li>
					<li><span class="check" aria-hidden="true">[✓]</span> {t("why.list3")}</li>
				</ul>
			</div>
			<table class="compare">
				<caption>{t("why.compare.caption")}</caption>
				<thead>
					<tr>
						<td></td>
						<th scope="col">{t("why.compare.cloud")}</th>
						<th scope="col" class="compare-local">{t("why.compare.local")}</th>
					</tr>
				</thead>
				<tbody>
					{compareRows.map((row) => (
						<tr>
							<th scope="row">{row.label}</th>
							<td>{row.cloud}</td>
							<td class="compare-local">{row.local}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section id="faq" class="section">
		<SectionHeading number="04" tag={t("faq.tag")} title={t("faq.title")} description={t("faq.description")} viewEvent="view_faq" />
		<Faq lang={lang} />
	</section>

	<section class="cta">
		<div class="cta-inner" data-reveal>
			<div class="cta-copy">
				<span class="cta-label">{t("cta.label")}</span>
				<h2>{t("cta.title")}</h2>
				<p>{t("cta.description")}</p>
			</div>
			<div class="cta-action">
				<a href={downloadHref} class="cta-btn" data-umami-event="bottom_cta_click">
					<span class="btn-icon">↓</span> {t("cta.button")}
				</a>
				<span class="cta-note">{t("cta.note")}</span>
			</div>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	.hero, .section { max-width: 1280px; margin: 0 auto; padding-inline: 40px; }
	.hero { padding-top: 156px; }
	.hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }
	.hero-label { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
	.label-line { width: 7px; height: 7px; background: #ff3e00; box-shadow: 0 0 16px #ff3e0050; }
	.label-text { font-size: 11px; color: #ff6b3d; letter-spacing: .12em; }
	.hero-title { font-size: clamp(40px, 5vw, 68px); font-weight: 600; line-height: 1.08; letter-spacing: -.06em; margin-bottom: 28px; }
	.title-line { display: block; }
	.title-accent { color: #ff4d19; }
	.hero-description { max-width: 530px; font-size: 15px; line-height: 1.85; color: #a8a8a8; margin-bottom: 32px; }
	.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
	.btn-primary, .btn-secondary, .cta-btn { display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 16px 22px; font-size: 12px; font-weight: 600; transition: background .2s, color .2s, border-color .2s, transform .12s, box-shadow .12s; }
	.btn-primary, .cta-btn { background: #ff4d19; border: 1px solid #ff4d19; color: #090909; box-shadow: 4px 4px 0 #7a2409; }
	.btn-primary:hover, .cta-btn:hover { background: #ff7045; border-color: #ff7045; transform: translate(-1px, -1px); box-shadow: 5px 5px 0 #7a2409; }
	.btn-primary:active, .cta-btn:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 #7a2409; }
	.btn-secondary { border: 1px solid #383838; color: #ccc; }
	.btn-secondary:hover { background: #1c1c1c; border-color: #777; color: #fff; }
	.btn-icon { font-size: 18px; }
	.hero-note { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 22px; color: #888; font-size: 10px; line-height: 1.8; }
	.hero-note > span:first-child { color: #ff6b3d; }
	.note-divider { color: #444; }
	.hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid #303030; margin-top: 76px; }
	.stat { padding: 27px 28px; display: flex; align-items: center; gap: 18px; }
	.stat:first-child { padding-left: 0; }
	.stat + .stat { border-left: 1px solid #303030; }
	.stat-value { font-size: 34px; letter-spacing: -.05em; line-height: 1; color: #e6e6e6; }
	.stat-label { font-size: 10px; color: #969696; text-transform: uppercase; line-height: 1.7; max-width: 150px; letter-spacing: .05em; }
	.ticker { display: flex; align-items: center; border-bottom: 1px solid #303030; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
	.ticker-label { flex-shrink: 0; padding: 16px 20px 16px 0; border-right: 1px solid #303030; color: #ff6b3d; }
	.ticker-window { flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent); }
	.ticker-track { display: flex; width: max-content; animation: ticker 44s linear infinite; }
	.ticker-track ul { display: flex; flex-shrink: 0; list-style: none; }
	.ticker-track li { display: flex; align-items: center; color: #8f8f8f; white-space: nowrap; }
	.ticker-track li::after { content: "/"; margin-inline: 22px; color: #4a4a4a; }
	.ticker:hover .ticker-track { animation-play-state: paused; }
	@keyframes ticker { to { transform: translateX(-50%); } }
	.section { padding-top: 112px; }
	.highlight-block { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; padding: 48px; border: 1px solid #493026; border-left: 3px solid #ff4d19; background: #15110f; }
	.highlight-label { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: #ff6b3d; margin-bottom: 18px; }
	.highlight-title { font-size: clamp(26px, 2.8vw, 36px); line-height: 1.25; font-weight: 500; letter-spacing: -.05em; margin-bottom: 18px; }
	.highlight-desc { font-size: 13px; color: #a39893; line-height: 1.9; }
	.highlight-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
	.highlight-list li { display: flex; gap: 12px; font-size: 12px; color: #c4bdb8; line-height: 1.8; }
	.check { color: #ff6b3d; flex-shrink: 0; }
	.compare { width: 100%; border-collapse: collapse; border: 1px solid #3c2e25; background: #100e0c; font-size: 12px; }
	.compare caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	.compare th, .compare td { padding: 15px 16px; text-align: left; vertical-align: top; line-height: 1.6; font-weight: 400; }
	.compare thead th { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #8d7f77; }
	.compare tbody tr { border-top: 1px solid #2c221c; }
	.compare tbody th { color: #8d7f77; font-size: 11px; white-space: nowrap; }
	.compare tbody td { color: #84807d; }
	.compare tbody .compare-local, .compare thead .compare-local { border-left: 1px solid #3c2e25; background: #1d1511; }
	.compare tbody .compare-local { color: #f3ddd2; }
	.compare thead .compare-local { color: #ff754c; }
	.cta { margin-top: 112px; border-top: 1px solid #303030; background: #111; }
	.cta-inner { max-width: 1280px; margin: auto; padding: 72px 40px; display: flex; align-items: center; justify-content: space-between; gap: 56px; }
	.cta-label { font-size: 10px; letter-spacing: .1em; color: #ff6b3d; }
	.cta h2 { margin: 18px 0 14px; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.22; font-weight: 500; letter-spacing: -.05em; max-width: 680px; }
	.cta p { font-size: 13px; color: #999; max-width: 590px; line-height: 1.8; }
	.cta-action { display: flex; flex-direction: column; align-items: flex-end; gap: 18px; flex-shrink: 0; }
	.cta-btn { padding: 18px 26px; font-size: 13px; }
	.cta-note { font-size: 10px; color: #777; letter-spacing: .04em; }
	@media (max-width: 1050px) {
		.hero-grid { gap: 32px; }
		.hero, .section { padding-inline: 28px; }
		.stat { padding-inline: 18px; gap: 12px; flex-direction: column; align-items: flex-start; }
		.highlight-block { gap: 36px; padding: 32px; }
		.cta-inner { padding-inline: 28px; }
	}
	@media (max-width: 800px) {
		.hero { padding-top: 120px; }
		.hero-grid { grid-template-columns: 1fr; gap: 48px; }
		.hero-title { font-size: clamp(40px, 9vw, 64px); }
		.hero-description { max-width: 600px; }
		.hero-stats { grid-template-columns: repeat(2, 1fr); margin-top: 56px; }
		.stat:nth-child(odd) { padding-left: 0; border-left: 0; }
		.stat:nth-child(n + 3) { border-top: 1px solid #303030; }
		.section { padding-top: 72px; }
		.highlight-block { grid-template-columns: 1fr; }
		.cta { margin-top: 72px; }
		.cta-inner { flex-direction: column; align-items: flex-start; gap: 32px; padding-block: 52px; }
		.cta-action { align-items: flex-start; }
	}
	@media (max-width: 540px) {
		.hero, .section { padding-inline: 20px; }
		.hero-label { margin-bottom: 22px; }
		.label-text { font-size: 10px; }
		.hero-title { font-size: clamp(32px, 9.3vw, 48px); }
		.hero-description { font-size: 14px; }
		.btn-primary, .btn-secondary { padding: 15px 18px; font-size: 11px; }
		.hero-note { font-size: 9px; gap: 7px; }
		.stat { padding: 22px 14px; }
		.stat-value { font-size: 28px; }
		.stat-label { font-size: 9px; letter-spacing: 0; }
		.ticker-label { padding-right: 14px; }
		.highlight-block { padding: 28px 22px; }
		.compare th, .compare td { padding: 12px 10px; }
		.compare { font-size: 11px; }
		.compare tbody th { white-space: normal; font-size: 10px; }
		.cta-inner { padding-inline: 20px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track { animation: none; }
		.btn-primary, .btn-secondary, .cta-btn { transition: none; }
	}
</style>

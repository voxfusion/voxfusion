---
import Faq from "../components/Faq.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import { faqItems } from "../data/faq";
import { defaultLang, getLocalizedPath, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqPageSchema, schemaGraph, softwareApplicationSchema } from "../seo";

const lang = defaultLang;
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");
const schema = schemaGraph(softwareApplicationSchema(description), faqPageSchema(faqItems(t)));
const downloadHref = getLocalizedPath("/download/", lang);
const githubHref = "https://github.com/voxfusion/voxfusion";
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	schema={schema}
	showNavLinks
	ctaHref={downloadHref}
	ctaLabel={`${t("nav.download")} →`}
>
	<main id="main-content">
	<header class="hero">
		<h1 class="hero-title">
			<span>{t("hero.title.line1")}</span>
			<span>{t("hero.title.line2")}</span>
			<span class="title-accent">{t("hero.title.line3")}</span>
		</h1>
		<p class="hero-description">{t("hero.subtitle")}</p>
		<div class="hero-actions">
			<a href={downloadHref} class="btn-primary" data-umami-event="hero_download_click">
				<span class="btn-icon" aria-hidden="true">↓</span>
				<span>{t("hero.cta.download")}</span>
			</a>
			<a href={githubHref} target="_blank" rel="noopener noreferrer" class="text-link" data-umami-event="hero_github_click">{t("hero.cta.github")} <span aria-hidden="true">→</span></a>
		</div>
	</header>

	<section id="features" class="section">
		<FeatureGrid lang={lang} />
	</section>

	<section id="faq" class="section">
		<Faq lang={lang} />
	</section>
	</main>
</BaseLayout>

<style>
	.hero, .section { max-width: 1280px; margin: 0 auto; padding-inline: 40px; }
	.hero { padding-top: 184px; }

	.hero-title { margin-bottom: 32px; font-size: clamp(40px, 5vw, 70px); font-weight: 600; line-height: 1.06; letter-spacing: -.06em; }
	.hero-title span { display: block; }
	.title-accent { color: #ff4d19; }
	.hero-description { max-width: 460px; margin-bottom: 40px; color: #a8a8a8; font-size: 16px; line-height: 1.75; }
	.hero-actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
	/* Outlined at rest, filled on hover: one solid orange block above the fold reads as "dark page, neon button". */
	.btn-primary { display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 17px 24px; font-size: 13px; font-weight: 600; background: #0a0a0a; border: 1px solid #ff4d19; color: #ff4d19; box-shadow: 4px 4px 0 #7a2409; transition: background .2s, color .2s, transform .12s, box-shadow .12s; }
	.btn-primary:hover { background: #ff4d19; color: #090909; }
	.btn-primary:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 #7a2409; }
	.btn-icon { font-size: 18px; }
	.text-link { padding-bottom: 3px; border-bottom: 1px solid #3a3a3a; color: #cfcfcf; font-size: 13px; transition: color .2s, border-color .2s; }
	.text-link:hover { color: #fff; border-color: #ff6b3d; }

	.section { padding-top: 120px; }
	#faq { padding-top: 144px; padding-bottom: 168px; }

	@media (max-width: 1050px) {
		.hero, .section { padding-inline: 28px; }
	}
	@media (max-width: 800px) {
		.hero { padding-top: 128px; }
		.section { padding-top: 88px; }
		#faq { padding-top: 104px; padding-bottom: 104px; }
	}
	@media (max-width: 540px) {
		.hero, .section { padding-inline: 20px; }
		.hero { padding-top: 112px; }
		.hero-title { margin-bottom: 24px; font-size: clamp(36px, 11vw, 48px); }
		.hero-description { margin-bottom: 32px; font-size: 15px; }
		.section { padding-top: 72px; }
		#faq { padding-top: 88px; padding-bottom: 88px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.btn-primary, .text-link { transition: none; }
	}
</style>

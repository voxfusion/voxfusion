---
import Faq from "../components/Faq.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import HeroDemo from "../components/HeroDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PrivacyFlow from "../components/PrivacyFlow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { faqItems } from "../data/faq";
import { defaultLang, getLocalizedPath, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqPageSchema, schemaGraph, softwareApplicationSchema } from "../seo";

const lang = defaultLang;
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");
const schema = schemaGraph(softwareApplicationSchema(description), faqPageSchema(faqItems(t)));
const downloadHref = getLocalizedPath("/download/", lang);
const githubHref = "https://github.com/voxfusion/voxfusion";
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	schema={schema}
	showNavLinks
	ctaHref={downloadHref}
	ctaLabel={`${t("nav.download")} →`}
>
	<main id="main-content">
	<header class="hero">
		<div class="hero-content">
			<div class="hero-label enter">
				<span class="label-line" aria-hidden="true"></span>
				<span class="label-text">{t("hero.label")}</span>
			</div>
			<h1 class="hero-title">
				<span class="title-line"><span style="--d: .08s">{t("hero.title.line1")}</span></span>
				<span class="title-line"><span style="--d: .18s">{t("hero.title.line2")}</span></span>
				<span class="title-line title-accent"><span style="--d: .28s">{t("hero.title.line3")}</span></span>
			</h1>
			<p class="hero-description enter" style="--d: .42s">{t("hero.subtitle")}</p>
			<div class="hero-actions enter" style="--d: .52s">
				<a href={downloadHref} class="btn-primary" data-umami-event="hero_download_click">
					<span class="btn-icon" aria-hidden="true">↓</span>
					<span>{t("hero.cta.download")}</span>
				</a>
				<a href={githubHref} target="_blank" rel="noopener noreferrer" class="text-link" data-umami-event="hero_github_click">{t("hero.cta.github")} <span aria-hidden="true">→</span></a>
			</div>
			<p class="hero-note enter" style="--d: .6s">{t("hero.note")}</p>
		</div>
		<div class="hero-demo enter" style="--d: .35s"><HeroDemo lang={lang} /></div>
	</header>

	<section id="how" class="section">
		<SectionHeading number="01" tag={t("how.tag")} title={t("how.title")} description={t("how.description")} viewEvent="view_how" />
		<HowItWorks lang={lang} />
	</section>

	<section id="features" class="section">
		<SectionHeading number="02" tag={t("features.tag")} title={t("features.title")} description={t("features.description")} viewEvent="view_features" />
		<FeatureGrid lang={lang} />
	</section>

	<section id="privacy" class="section">
		<SectionHeading number="03" tag={t("why.section")} title={t("why.title")} description={t("why.description")} viewEvent="view_privacy" />
		<PrivacyFlow lang={lang} />
		<div class="privacy-points">
			<ul>
				<li><span aria-hidden="true">[✓]</span> {t("why.list1")}</li>
				<li><span aria-hidden="true">[✓]</span> {t("why.list2")}</li>
				<li><span aria-hidden="true">[✓]</span> {t("why.list3")}</li>
			</ul>
			<a href={githubHref} target="_blank" rel="noopener noreferrer" class="text-link" data-umami-event="privacy_github_click">{t("why.source")} <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section id="faq" class="section">
		<SectionHeading number="04" tag={t("faq.tag")} />
		<Faq lang={lang} />
	</section>

	<section class="section cta">
		<div class="cta-rule"></div>
		<h2>{t("cta.title")}</h2>
		<div class="cta-actions">
			<a href={downloadHref} class="btn-primary" data-umami-event="bottom_cta_click">
				<span class="btn-icon" aria-hidden="true">↓</span>
				<span>{t("cta.button")}</span>
			</a>
			<span class="cta-note">{t("cta.note")}</span>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	.hero, .section { max-width: 1280px; margin: 0 auto; padding-inline: 40px; }
	.hero { display: grid; grid-template-columns: 1.08fr 1fr; gap: 64px; align-items: center; padding-top: 188px; padding-bottom: 24px; }
	.hero-demo { min-width: 0; }

	/* Entrance: the hero settles in once, in reading order. */
	.enter { animation: enter .8s var(--ease-out) var(--d, 0s) backwards; }
	@keyframes enter { from { opacity: 0; transform: translateY(16px); } }
	.title-line { display: block; overflow: hidden; padding-bottom: .14em; margin-bottom: -.14em; }
	.title-line > span { display: block; animation: line-up .9s var(--ease-out) var(--d, 0s) backwards; }
	@keyframes line-up { from { transform: translateY(110%); } }

	.hero-label { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
	.label-line { width: 7px; height: 7px; background: #ff3e00; }
	.label-text { font-size: 11px; color: #a3a3a3; letter-spacing: .14em; }
	.hero-title { font-size: clamp(40px, 5vw, 70px); font-weight: 600; line-height: 1.06; letter-spacing: -.06em; margin-bottom: 32px; white-space: nowrap; }
	.title-accent { color: #ff4d19; }
	.hero-description { max-width: 420px; font-size: 16px; line-height: 1.75; color: #a8a8a8; margin-bottom: 40px; }
	.hero-actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
	.btn-primary { display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 17px 24px; font-size: 13px; font-weight: 600; background: #ff4d19; border: 1px solid #ff4d19; color: #090909; box-shadow: 4px 4px 0 #7a2409; transition: background .2s, border-color .2s, transform .12s, box-shadow .12s; }
	.btn-primary:hover { background: #ff7045; border-color: #ff7045; transform: translate(-1px, -1px); box-shadow: 5px 5px 0 #7a2409; }
	.btn-primary:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 #7a2409; }
	.btn-icon { font-size: 18px; transition: transform .2s var(--ease-out); }
	.btn-primary:hover .btn-icon { transform: translateY(2px); }
	.text-link { padding-bottom: 3px; border-bottom: 1px solid #3a3a3a; color: #cfcfcf; font-size: 13px; transition: color .2s, border-color .2s; }
	.text-link:hover { color: #fff; border-color: #ff6b3d; }
	.text-link span { display: inline-block; transition: transform .2s var(--ease-out); }
	.text-link:hover span { transform: translateX(3px); }
	.hero-note { margin-top: 28px; color: #7a7a7a; font-size: 11px; letter-spacing: .04em; }

	.section { padding-top: 168px; }

	.privacy-points { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; margin-top: 40px; }
	.privacy-points ul { display: flex; flex-wrap: wrap; gap: 12px 40px; list-style: none; }
	.privacy-points li { display: flex; gap: 12px; color: #a8a8a8; font-size: 13px; line-height: 1.7; }
	.privacy-points li span { flex-shrink: 0; color: #ff6b3d; }

	.cta { padding-bottom: 168px; }
	.cta-rule { height: 1px; margin-bottom: 72px; background: #292929; }
	.cta h2 { max-width: 860px; font-size: clamp(30px, 4.4vw, 60px); line-height: 1.12; font-weight: 500; letter-spacing: -.055em; }
	.cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; margin-top: 44px; }
	.cta-note { color: #7a7a7a; font-size: 11px; letter-spacing: .04em; }

	@media (max-width: 1050px) {
		.hero { gap: 40px; }
		.hero, .section { padding-inline: 28px; }
		.section { padding-top: 136px; }
		.cta { padding-bottom: 136px; }
	}
	@media (max-width: 800px) {
		.hero { grid-template-columns: 1fr; gap: 56px; padding-top: 128px; }
		.hero-title { font-size: clamp(40px, 9.6vw, 64px); }
		.section { padding-top: 104px; }
		.cta { padding-bottom: 104px; }
		.cta-rule { margin-bottom: 48px; }
	}
	@media (max-width: 540px) {
		.hero, .section { padding-inline: 20px; }
		.hero { padding-top: 112px; gap: 44px; }
		.hero-label { margin-bottom: 24px; }
		.hero-title { font-size: clamp(30px, 9.6vw, 48px); margin-bottom: 24px; }
		.hero-description { font-size: 15px; margin-bottom: 32px; }
		.section { padding-top: 88px; }
		.privacy-points ul { flex-direction: column; gap: 10px; }
		.cta { padding-bottom: 88px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.enter, .title-line > span { animation: none; }
		.btn-primary, .btn-icon, .text-link, .text-link span { transition: none; }
	}
</style>

---
import FeatureGrid from "../components/FeatureGrid.astro";
import { defaultLang, getLocalizedPath, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { softwareApplicationSchema } from "../seo";

const lang = defaultLang;
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");
const schema = softwareApplicationSchema(description);
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	schema={schema}
	showNavLinks
	ctaHref={getLocalizedPath("/download", lang)}
	ctaLabel={`${t("nav.download")} →`}
>
	<main id="main-content">
	<header class="hero">
		<div class="hero-grid">
			<div class="hero-content">
				<div class="hero-label">
					<span class="label-line" aria-hidden="true"></span>
					<span class="label-text">LOCAL VOICE TO TEXT / macOS</span>
				</div>
				<h1 class="hero-title">
					<span class="title-line">{t("hero.title.line1")}</span>
					<span class="title-line title-accent">{t("hero.title.line2")}</span>
				</h1>
				<p class="hero-description">{t("hero.subtitle")}</p>
				<div class="hero-actions">
					<a href={getLocalizedPath("/download", lang)} class="btn-primary" data-umami-event="hero_download_click">
						<span class="btn-icon">↓</span>
						<span>{t("hero.cta.download")}</span>
					</a>
					<a href="https://github.com/voxfusion/voxfusion" target="_blank" rel="noopener noreferrer" class="btn-secondary" data-umami-event="hero_github_click">
						<svg class="btn-icon" viewBox="0 0 1024 1024" width="16" height="16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0" clip-rule="evenodd"/></svg>
						<span>{t("nav.github")}</span>
					</a>
				</div>
				<p class="hero-note"><span aria-hidden="true">[✓]</span> Free & open source <span class="note-divider">/</span> No account needed</p>
			</div>
			<div class="hero-visual" aria-label="Example of voice dictation into Messages">
				<div class="visual-caption"><span>01 / VOICE → TEXT</span><span>WORKFLOW DEMO</span></div>
				<div class="terminal">
					<div class="terminal-header">
						<span class="terminal-title"><span class="terminal-mark" aria-hidden="true">✳</span> voxfusion</span>
						<span class="local-status"><span></span> ON DEVICE</span>
					</div>
					<div class="terminal-body">
						<div class="input-label"><span>VOICE INPUT</span><span class="hotkey"><kbd>⌃</kbd> + <kbd>⌥</kbd></span></div>
						<p class="spoken-text">“Hey team, let's schedule<br class="desktop-break" /> a quick sync for tomorrow.”</p>
						<div class="waveform-raw" aria-hidden="true">
							{Array.from({ length: 48 }, (_, i) => (
								<div class="wave-bar" style={'--i: ' + i + '; --h: ' + (18 + Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.23)) * 82) + '%'}></div>
							))}
						</div>
						<div class="processing-line"><span class="prompt">↳</span> Transcribed locally <span class="processing-engine">whisper.cpp</span></div>
						<div class="text-output">
							<div class="output-label"><span>MESSAGES.APP</span><span class="success">[INSERTED]</span></div>
							<p>Hey team, let's schedule a quick sync for tomorrow.<span class="cursor" aria-hidden="true">▎</span></p>
						</div>
					</div>
					<div class="terminal-footer"><span>Audio stays on your Mac.</span><span aria-hidden="true">↗</span></div>
				</div>
			</div>
		</div>
		<div class="hero-stats">
			<div class="stat">
				<span class="stat-value">{t("hero.stat.words.value")}</span>
				<span class="stat-label">{t("hero.stat.words.label")}</span>
			</div>
			<div class="stat">
				<span class="stat-value">{t("hero.stat.languages.value")}</span>
				<span class="stat-label">{t("hero.stat.languages.label")}</span>
			</div>
			<div class="stat">
				<span class="stat-value">{t("hero.stat.apps.value")}</span>
				<span class="stat-label">{t("hero.stat.apps.label")}</span>
			</div>
		</div>
	</header>

	<section id="features" class="features" data-umami-view="view_features">
		<div class="section-header">
			<span class="section-number">01</span>
			<h2 class="section-title">{t("features.tag")}</h2>
			<div class="section-line"></div>
		</div>
		<div class="section-intro">
			<h3>{t("features.title")}</h3>
			<p>{t("features.description")}</p>
		</div>
		<FeatureGrid lang={lang} />

		<div class="highlight-block">
			<div class="privacy-heading">
			<div class="highlight-label">{t("features.highlight.tag")}</div>
			<h3 class="highlight-title">{t("features.highlight.title")}</h3>
			<p class="highlight-desc">{t("features.highlight.description")}</p>
			</div>
			<ul class="highlight-list">
				<li><span class="check">[✓]</span> {t("features.highlight.list1")}</li>
				<li><span class="check">[✓]</span> {t("features.highlight.list2")}</li>
				<li><span class="check">[✓]</span> {t("features.highlight.list3")}</li>
			</ul>
		</div>
	</section>

	<section class="cta">
		<div class="cta-inner">
			<div class="cta-copy">
			<span class="cta-label">YOUR VOICE. YOUR MAC.</span>
			<h2>{t("cta.title")}</h2>
			<p>{t("cta.description")}</p>
			</div>
			<a href={getLocalizedPath("/download", lang)} class="cta-btn" data-umami-event="bottom_cta_click">
				<span>↓</span> {t("cta.button")}
			</a>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	.hero, .features { max-width: 1280px; margin: 0 auto; padding-inline: 40px; }
	.hero { padding-top: 164px; padding-bottom: 0; }
	.hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }
	.hero-label { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
	.label-line { width: 7px; height: 7px; background: #ff3e00; box-shadow: 0 0 16px #ff3e0050; }
	.label-text { font-size: 11px; color: #ff6b3d; letter-spacing: .12em; }
	.hero-title { font-size: clamp(38px, 4.4vw, 60px); font-weight: 600; line-height: 1.12; letter-spacing: -.06em; margin-bottom: 26px; }
	.title-line { display: block; }
	.title-accent { color: #ff4d19; }
	.hero-description { max-width: 520px; font-size: 14px; line-height: 1.9; color: #a1a1a1; margin-bottom: 30px; }
	.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
	.btn-primary, .btn-secondary, .cta-btn { display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 16px 22px; font-size: 12px; font-weight: 600; transition: background .2s, color .2s, border-color .2s; }
	.btn-primary, .cta-btn { background: #ff4d19; border: 1px solid #ff4d19; color: #090909; }
	.btn-primary:hover, .cta-btn:hover { background: #ff7045; border-color: #ff7045; }
	.btn-secondary { border: 1px solid #383838; color: #ccc; }
	.btn-secondary:hover { background: #1c1c1c; border-color: #777; color: #fff; }
	.btn-icon { font-size: 18px; }
	.hero-note { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; color: #888; font-size: 10px; line-height: 1.8; }
	.hero-note > span:first-child { color: #ff6b3d; }
	.note-divider { color: #444; }
	.hero-visual { min-width: 0; }
	.visual-caption { display: flex; justify-content: space-between; gap: 12px; color: #777; font-size: 9px; letter-spacing: .08em; padding-bottom: 14px; }
	.visual-caption span:first-child { color: #aaa; }
	.terminal { background: #111; border: 1px solid #3b3b3b; box-shadow: 10px 10px 0 #0a0a0a, 11px 11px 0 #272727; }
	.terminal-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid #303030; background: #181818; }
	.terminal-title { font-size: 13px; color: #ccc; display: flex; align-items: center; gap: 10px; }
	.terminal-mark { color: #ff4d19; font-size: 24px; line-height: 1; }
	.local-status { display: flex; align-items: center; gap: 8px; color: #a9b7a9; font-size: 9px; letter-spacing: .08em; }
	.local-status span { width: 5px; height: 5px; background: #96bd96; }
	.terminal-body { padding: 24px; }
	.input-label, .output-label { display: flex; justify-content: space-between; align-items: center; font-size: 9px; letter-spacing: .06em; color: #919191; }
	.hotkey { display: flex; gap: 5px; align-items: center; }
	.hotkey kbd { display: inline-flex; justify-content: center; align-items: center; width: 23px; height: 23px; border: 1px solid #3a3a3a; border-bottom-width: 2px; color: #ccc; font-size: 14px; }
	.spoken-text { font-size: 17px; line-height: 1.7; margin-top: 18px; color: #ddd; letter-spacing: -.025em; }
	.waveform-raw { display: flex; align-items: center; justify-content: space-between; gap: 4px; height: 60px; margin: 22px 0; }
	.wave-bar { width: 4px; height: var(--h); background: #ff4d19; opacity: .8; animation: wave 2s ease-in-out infinite; animation-delay: calc(var(--i) * -.08s); }
	@keyframes wave { 0%, 100% { transform: scaleY(.45); opacity: .55; } 50% { transform: scaleY(1); opacity: 1; } }
	.processing-line { display: flex; gap: 8px; align-items: center; padding: 14px 0; border-top: 1px solid #292929; color: #8c8c8c; font-size: 10px; }
	.prompt { color: #ff6b3d; }
	.processing-engine { margin-left: auto; color: #777; }
	.text-output { border: 1px solid #343434; padding: 16px; background: #191919; }
	.success { color: #9ebd9e; }
	.text-output p { color: #d5d5d5; font-size: 13px; line-height: 1.8; margin-top: 12px; }
	.cursor { color: #ff4d19; }
	.terminal-footer { display: flex; justify-content: space-between; padding: 13px 22px; border-top: 1px solid #303030; color: #888; font-size: 10px; }
	.terminal-footer span:last-child { color: #ff6b3d; }
	.hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid #303030; margin-top: 76px; }
	.stat { padding: 27px 32px; display: flex; align-items: center; gap: 20px; }
	.stat:first-child { padding-left: 0; }
	.stat + .stat { border-left: 1px solid #303030; }
	.stat-value { font-size: 34px; letter-spacing: -.05em; line-height: 1; color: #e6e6e6; }
	.stat-label { font-size: 10px; color: #969696; text-transform: uppercase; line-height: 1.7; max-width: 150px; letter-spacing: .05em; }
	.features { padding-block: 104px; scroll-margin-top: 68px; }
	.section-header { display: flex; gap: 16px; align-items: center; margin-bottom: 34px; }
	.section-number { font-size: 11px; color: #ff6b3d; }
	.section-title { font-size: 11px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; color: #a3a3a3; }
	.section-line { flex: 1; height: 1px; background: #292929; }
	.section-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 72px; align-items: end; margin-bottom: 48px; }
	.section-intro h3 { font-size: clamp(32px, 3.8vw, 48px); line-height: 1.25; letter-spacing: -.05em; font-weight: 500; max-width: 550px; }
	.section-intro p { font-size: 14px; line-height: 1.85; color: #aaa; max-width: 440px; }
	.highlight-block { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 64px; margin-top: 48px; padding: 42px; border: 1px solid #493026; border-left: 3px solid #ff4d19; background: #15110f; }
	.highlight-label { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: #ff6b3d; margin-bottom: 18px; }
	.highlight-title { font-size: 25px; line-height: 1.4; font-weight: 500; letter-spacing: -.04em; margin-bottom: 14px; }
	.highlight-desc { font-size: 12px; color: #a39893; line-height: 1.9; }
	.highlight-list { list-style: none; display: flex; flex-direction: column; gap: 18px; }
	.highlight-list li { display: flex; gap: 12px; font-size: 12px; color: #c4bdb8; line-height: 1.8; }
	.check { color: #ff6b3d; flex-shrink: 0; }
	.cta { border-top: 1px solid #303030; background: #111; }
	.cta-inner { max-width: 1280px; margin: auto; padding: 64px 40px; display: flex; align-items: center; justify-content: space-between; gap: 56px; }
	.cta-label { font-size: 10px; letter-spacing: .1em; color: #ff6b3d; }
	.cta h2 { margin: 18px 0 14px; font-size: clamp(26px, 3vw, 34px); line-height: 1.3; font-weight: 500; letter-spacing: -.05em; }
	.cta p { font-size: 12px; color: #999; max-width: 590px; line-height: 1.8; }
	.cta-btn { flex-shrink: 0; }
	@media (max-width: 1050px) {
		.hero-grid { gap: 32px; }
		.hero-title { font-size: 46px; }
		.hero, .features { padding-inline: 28px; }
		.terminal-body { padding: 20px; }
		.spoken-text { font-size: 15px; }
		.desktop-break { display: none; }
		.stat { padding-inline: 24px; gap: 14px; }
		.highlight-block { gap: 32px; padding: 32px; }
	}
	@media (max-width: 800px) {
		.hero { padding-top: 120px; }
		.hero-grid { grid-template-columns: 1fr; gap: 48px; }
		.hero-title { font-size: clamp(38px, 7vw, 58px); max-width: 620px; }
		.hero-description { max-width: 600px; }
		.hero-visual { max-width: 580px; width: 100%; }
		.hero-stats { margin-top: 56px; }
		.stat { flex-direction: column; align-items: flex-start; gap: 12px; }
		.section-intro { grid-template-columns: 1fr; gap: 20px; }
		.features { padding-block: 64px; }
		.highlight-block { grid-template-columns: 1fr; gap: 28px; }
		.cta-inner { flex-direction: column; align-items: flex-start; gap: 28px; padding: 48px 28px; }
	}
	@media (max-width: 540px) {
		.hero, .features { padding-inline: 20px; }
		.hero-label { margin-bottom: 22px; }
		.label-text { font-size: 10px; }
		.hero-title { font-size: clamp(32px, 9.3vw, 48px); }
		.hero-description { font-size: 13px; }
		.btn-primary, .btn-secondary { padding: 15px 18px; font-size: 11px; }
		.hero-note { font-size: 9px; gap: 7px; }
		.terminal-body { padding: 18px; }
		.terminal-header { padding: 16px 18px; }
		.waveform-raw { gap: 3px; }
		.processing-line { font-size: 9px; gap: 6px; }
		.processing-engine { font-size: 8px; }
		.stat { padding: 24px 14px; }
		.stat-value { font-size: 28px; }
		.stat-label { font-size: 9px; letter-spacing: 0; }
		.highlight-block { padding: 28px 22px; }
		.highlight-title { font-size: 23px; }
		.cta-inner { padding-inline: 20px; }
	}
	@media (prefers-reduced-motion: reduce) { .wave-bar { animation: none; } }
</style>
